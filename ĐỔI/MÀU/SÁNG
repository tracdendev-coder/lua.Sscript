--------------------------------------------------------------------------------
-- 3. CORE MANAGEMENT & OPTIMIZATION ENGINE
--------------------------------------------------------------------------------
local ManagedObjects = {} -- Cache danh sách Instance -> {OriginalColor, OriginalSequence, Group, Instance}
local OriginalProperties = {}

local SystemEngine = {}

-- Lưu trữ thuộc tính gốc
local function BackupOriginal(inst)
	if OriginalProperties[inst] then return end
	local orig = {}
	if inst:IsA("ParticleEmitter") then
		orig.Color = inst.Color
	elseif inst:IsA("Beam") or inst:IsA("Trail") then
		orig.Color = inst.Color
	elseif inst:IsA("Light") then
		orig.Color = inst.Color
	elseif inst:IsA("BasePart") then
		orig.Color = inst.Color
	end
	OriginalProperties[inst] = orig
end

-- Phân loại Instance thuộc Nhóm nào
local function CategorizeInstance(inst)
	local name = inst.Name:lower()
	
	if name:find("sand") or name:find("dust") or name:find("particle") or name:find("particleemitter") or name:find("bui") or name:find("cat") then
		return "CÁT / BỤI / HẠT"
	elseif name:find("trail") or name:find("dash") or name:find("move") or name:find("dichuyen") then
		return "HIỆU ỨNG DI CHUYỂN"
	elseif name:find("slash") or name:find("hit") or name:find("attack") or name:find("tancong") then
		return "HIỆU ỨNG TẤN CÔNG"
	elseif name:find("skill") or name:find("magic") or name:find("aura") or name:find("kynang") then
		return "HIỆU ỨNG KỸ NĂNG"
	elseif inst:IsDescendantOf(LocalPlayer.Character) then
		if inst:FindFirstAncestorOfClass("Tool") or name:find("sword") or name:find("weapon") or name:find("vukhi") then
			return "VŨ KHÍ"
		else
			return "NHÂN VẬT"
		end
	end
	return "HIỆU ỨNG KỸ NĂNG" -- Mặc định
end

-- Thêm đối tượng vào danh sách quản lý
function SystemEngine.RegisterInstance(inst)
	if not inst or not inst.Parent then return end
	if ManagedObjects[inst] then return end
	
	-- Chỉ chấp nhận loại đối tượng hiển thị được phép
	if not (inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Light")) then
		return
	end

	BackupOriginal(inst)
	local group = CategorizeInstance(inst)

	ManagedObjects[inst] = {
		Instance = inst,
		Group = group
	}
end

-- Xóa đối tượng chết/bị hủy
function SystemEngine.SweepDeadObjects()
	local count = 0
	for inst, _ in pairs(ManagedObjects) do
		if not inst or not inst.Parent then
			ManagedObjects[inst] = nil
			OriginalProperties[inst] = nil
		else
			count = count + 1
		end
	end
	State.ManagedObjectsCount = count
end

-- Đổi màu trực tiếp lên Instance mà không tạo mới
function SystemEngine.ApplyColorToInstance(inst, color3)
	if not inst or not inst.Parent then return end
	
	if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
		inst.Color = ColorSequence.new(color3)
	elseif inst:IsA("Light") then
		inst.Color = color3
	end
end

-- Khôi phục màu gốc cho Instance
function SystemEngine.RestoreInstance(inst)
	local orig = OriginalProperties[inst]
	if not orig then return end
	if inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") then
		if orig.Color then inst.Color = orig.Color end
	elseif inst:IsA("Light") then
		if orig.Color then inst.Color = orig.Color end
	end
end

--------------------------------------------------------------------------------
-- 4. RENDER LOOP & RAINBOW ENGINE (TỐI ƯU FPS HIGH-PERFORMANCE)
--------------------------------------------------------------------------------
local hue = 0
local lastUpdate = tick()
local frameCount = 0
local fpsTimer = tick()

RunService.RenderStepped:Connect(function(dt)
	-- Tính FPS
	frameCount = frameCount + 1
	if tick() - fpsTimer >= 1 then
		State.FPS = frameCount
		frameCount = 0
		fpsTimer = tick()

		-- Tự động tối ưu nếu FPS tụt
		if State.AutoOptimize and State.FPS < 30 and State.Quality ~= "TIẾT KIỆM FPS" then
			State.Quality = "TIẾT KIỆM FPS"
			print("[CẢNH BÁO MẠNG]: Đã tự động giảm hiệu ứng để duy trì FPS.")
		end
	end

	if not State.MasterToggle then return end

	-- Cập nhật Rainbow Hue
	hue = (hue + dt * State.RainbowSpeed * 0.2) % 1
	local rainbowColor = Color3.fromHSV(hue, 1, 1)

	-- Tốc độ cập nhật màu giảm theo chất lượng đồ họa để tiết kiệm CPU
	local now = tick()
	local updateInterval = 0
	if State.Quality == "CÂN BẰNG" then updateInterval = 0.05
	elseif State.Quality == "TIẾT KIỆM FPS" then updateInterval = 0.1 end

	if now - lastUpdate < updateInterval then return end
	lastUpdate = now

	-- Loop duy nhất quét toàn bộ Object đã Cache
	for inst, data in pairs(ManagedObjects) do
		if inst and inst.Parent then
			local groupData = State.Groups[data.Group]
			
			if groupData and groupData.Active then
				if groupData.Rainbow or (State.ApplyAllActive and State.ApplyAllColor == "Cầu vồng") then
					SystemEngine.ApplyColorToInstance(inst, rainbowColor)
				else
					local selectedColorName = State.ApplyAllActive and State.ApplyAllColor or groupData.Color
					local targetColor = COLOR_PALETTE[selectedColorName] or Color3.fromRGB(255,255,255)
					
					if selectedColorName == "Cầu vồng" then
						SystemEngine.ApplyColorToInstance(inst, rainbowColor)
					else
						SystemEngine.ApplyColorToInstance(inst, targetColor)
					end
				end
			end
		end
	end
end)

