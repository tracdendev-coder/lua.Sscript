    Title.BackgroundTransparency = 1

    Title.Text =
        "🎨 COLOR SWAP • DEEP MODE"

    Title.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    Title.TextSize = 18
    Title.Font = Enum.Font.GothamBold

    Title.Parent = Main

    --==================================================
    -- STATUS
    --==================================================

    local Status =
        Instance.new("TextLabel")

    Status.Name = "Status"

    Status.Size =
        UDim2.new(1, -20, 0, 35)

    Status.Position =
        UDim2.fromOffset(10, 48)

    Status.BackgroundTransparency = 1

    Status.Text =
        "Màu hiện tại: 🍇 Hành tím 100%"

    Status.TextColor3 =
        CurrentColor.Value

    Status.TextSize = 14
    Status.Font = Enum.Font.GothamMedium

    Status.Parent = Main

    --==================================================
    -- SCROLL
    --==================================================

    local Scroll =
        Instance.new("ScrollingFrame")

    Scroll.Size =
        UDim2.new(1, -20, 1, -135)

    Scroll.Position =
        UDim2.fromOffset(10, 85)

    Scroll.BackgroundTransparency = 1

    Scroll.BorderSizePixel = 0

    Scroll.ScrollBarThickness = 4

    Scroll.CanvasSize =
        UDim2.new(0, 0, 0, 430)

    Scroll.Parent = Main

    local Layout =
        Instance.new("UIListLayout")

    Layout.Padding =
        UDim.new(0, 7)

    Layout.HorizontalAlignment =
        Enum.HorizontalAlignment.Center

    Layout.Parent = Scroll

    --==================================================
    -- COLOR BUTTONS
    --==================================================

    for _, ColorData in ipairs(COLORS) do

        local Button =
            Instance.new("TextButton")

        Button.Size =
            UDim2.new(1, -10, 0, 38)

        Button.BackgroundColor3 =
            ColorData.Value

        Button.BorderSizePixel = 0

        Button.Text =
            ColorData.Name

        Button.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        Button.TextSize = 14

        Button.Font =
            Enum.Font.GothamBold

        Button.Parent = Scroll

        local ButtonCorner =
            Instance.new("UICorner")

        ButtonCorner.CornerRadius =
            UDim.new(0, 8)

        ButtonCorner.Parent = Button

        Button.MouseButton1Click:Connect(function()

            CurrentColor = ColorData
            Rainbow = false

            Status.Text =
                "Màu hiện tại: " ..
                ColorData.Name ..
                " • 100%"

            Status.TextColor3 =
                ColorData.Value

            ScanEffects()

        end)

    end

    --==================================================
    -- RAINBOW
    --==================================================

    local RainbowButton =
        Instance.new("TextButton")

    RainbowButton.Size =
        UDim2.new(1, -10, 0, 38)

    RainbowButton.BackgroundColor3 =
        Color3.fromRGB(100, 50, 180)

    RainbowButton.BorderSizePixel = 0

    RainbowButton.Text =
        "🌈 Cầu vồng"

    RainbowButton.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    RainbowButton.TextSize = 14

    RainbowButton.Font =
        Enum.Font.GothamBold

    RainbowButton.Parent = Scroll

    local RC =
        Instance.new("UICorner")

    RC.CornerRadius =
        UDim.new(0, 8)

    RC.Parent = RainbowButton

    RainbowButton.MouseButton1Click:Connect(function()

        Rainbow = true

        Status.Text =
            "Màu hiện tại: 🌈 Cầu vồng"

        ScanEffects()

    end)

    --==================================================
    -- APPLY
    --==================================================

    local Apply =
        Instance.new("TextButton")

    Apply.Size =
        UDim2.new(1, -20, 0, 40)

    Apply.Position =
        UDim2.new(0, 10, 1, -48)

    Apply.BackgroundColor3 =
        Color3.fromRGB(40, 40, 50)

    Apply.BorderSizePixel = 0

    Apply.Text =
        "⚡ ÉP MÀU 100%"

    Apply.TextColor3 =
        Color3.fromRGB(255, 255, 255)

    Apply.TextSize = 14

    Apply.Font =
        Enum.Font.GothamBold

    Apply.Parent = Main

    local AC =
        Instance.new("UICorner")

    AC.CornerRadius =
        UDim.new(0, 8)

    AC.Parent = Apply

    Apply.MouseButton1Click:Connect(function()

        ScanEffects()

    end)

    --==================================================
    -- DRAG
    --==================================================

    local Dragging = false
    local DragStart
    local StartPosition

    Main.InputBegan:Connect(function(Input)

        if Input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            Dragging = true
            DragStart = Input.Position
            StartPosition = Main.Position

        end

    end)

    Main.InputEnded:Connect(function(Input)

        if Input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            Dragging = false

        end

    end)

    UserInputService.InputChanged:Connect(function(Input)

        if not Dragging then
            return
        end

        if Input.UserInputType ==
            Enum.UserInputType.MouseMovement then

            local Delta =
                Input.Position - DragStart

            Main.Position =
                UDim2.new(
                    StartPosition.X.Scale,
                    StartPosition.X.Offset + Delta.X,
                    StartPosition.Y.Scale,
                    StartPosition.Y.Offset + Delta.Y
                )

        end

    end)

end

--==================================================
-- PHÍM M
--==================================================

UserInputService.InputBegan:Connect(function(
    Input,
    GameProcessed
)

    if GameProcessed then
        return
    end

    if Input.KeyCode == Enum.KeyCode.M then

        Open = not Open

        if Open then
            CreateMenu()
        elseif Gui then
            Gui.Enabled = false
        end

    end

end)

--==================================================
-- TỰ ĐỘNG QUÉT
--==================================================

task.spawn(function()

    while true do

        task.wait(CONFIG.ScanInterval)

        if Open then
            ScanEffects()
        end

    end

end)

--==================================================
-- KHỞI ĐỘNG
--==================================================

CreateMenu()
ScanEffects()
