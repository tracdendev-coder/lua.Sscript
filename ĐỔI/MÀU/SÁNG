--============================================================
-- COLOR SWAP v4.0
-- TÍM 100% - KHÔNG MENU
-- CLIENT ONLY
--
-- Không tạo GUI
-- Không tạo Part mới
-- Không đổi màu nhân vật
-- Không đổi màu vũ khí
-- Không thay đổi người chơi khác
--
-- Mục tiêu:
-- Đỏ -> Tím
-- Cam -> Tím
-- Vàng -> Tím
-- Xanh -> Tím
-- Trắng -> Tím
-- Mọi màu của hiệu ứng -> Tím
--============================================================

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

--============================================================
-- CẤU HÌNH
--============================================================

local CONFIG = {

	-- Tím trứng / tím cà
	PURPLE = Color3.fromRGB(
		145,
		55,
		210
	),

	-- Tím sáng hơn cho ánh sáng
	LIGHT_PURPLE = Color3.fromRGB(
		175,
		75,
		255
	),

	-- Khoảng cách xử lý
	MAX_DISTANCE = 250,

	-- Quét hiệu ứng mới
	SCAN_INTERVAL = 0.5,

	-- Không xử lý nhân vật
	IGNORE_CHARACTER = true,

	-- Không xử lý Tool / vũ khí
	IGNORE_TOOLS = true,
}

--============================================================
-- BỘ NHỚ ĐỐI TƯỢNG
--============================================================

local tracked = {}

--============================================================
-- KIỂM TRA CÓ PHẢI NHÂN VẬT / VŨ KHÍ KHÔNG
--============================================================

local function isIgnored(object)

	if not object then
		return true
	end

	local current = object

	while current and current ~= Workspace do

		-- Không đổi nhân vật
		if CONFIG.IGNORE_CHARACTER then

			for _, player in ipairs(
				Players:GetPlayers()
			) do

				if current == player.Character then
					return true
				end
			end
		end

		-- Không đổi Tool
		if CONFIG.IGNORE_TOOLS then

			if current:IsA("Tool") then
				return true
			end
		end

		current = current.Parent
	end

	return false
end

--============================================================
-- KIỂM TRA HIỆU ỨNG
--============================================================

local function isColorEffect(object)

	if not object then
		return false
	end

	if isIgnored(object) then
		return false
	end

	return (
		object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
		or object:IsA("Highlight")
	)
end

--============================================================
-- KIỂM TRA KHOẢNG CÁCH
--============================================================

local function isNearPlayer(object)

	local character =
		LocalPlayer.Character

	if not character then
		return true
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return true
	end

	local parent = object.Parent

	-- Nếu hiệu ứng nằm trực tiếp trên Part
	if parent and parent:IsA("BasePart") then

		return (
			parent.Position -
			root.Position
		).Magnitude <=
			CONFIG.MAX_DISTANCE
	end

	-- Tìm Part gần nhất
	local current = parent

	while current and current ~= Workspace do

		if current:IsA("BasePart") then

			return (
				current.Position -
				root.Position
			).Magnitude <=
				CONFIG.MAX_DISTANCE
		end

		current = current.Parent
	end

	return true
end

--============================================================
-- TẠO COLOR SEQUENCE TÍM 100%
--
-- Điểm quan trọng:
-- Không chỉ đổi một màu.
-- Toàn bộ các keypoint đều thành tím.
--
-- Ví dụ:
-- Đỏ -> Cam -> Vàng
-- trở thành:
-- Tím -> Tím -> Tím
--
-- Nhưng vẫn giữ nguyên độ trong suốt của từng điểm.
--============================================================

local function purpleSequence(oldSequence)

	if not oldSequence then
		return ColorSequence.new(
			CONFIG.PURPLE
		)
	end

	local keypoints = {}

	for _, keypoint in ipairs(
		oldSequence.Keypoints
	) do

		table.insert(
			keypoints,
			ColorSequenceKeypoint.new(
				keypoint.Time,
				CONFIG.PURPLE
			)
		)
	end

	return ColorSequence.new(keypoints)
end

--============================================================
-- ĐỔI MÀU PARTICLE
--============================================================

local function changeParticle(object)

	if not object:IsA("ParticleEmitter") then
		return
	end

	-- Ép toàn bộ ColorSequence thành tím
	object.Color =
		purpleSequence(object.Color)

	tracked[object] = true
end

--============================================================
-- ĐỔI MÀU TRAIL
--============================================================

local function changeTrail(object)

	if not object:IsA("Trail") then
		return
	end

	object.Color =
		purpleSequence(object.Color)

	tracked[object] = true
end

--============================================================
-- ĐỔI MÀU BEAM
--============================================================

local function changeBeam(object)

	if not object:IsA("Beam") then
		return
	end

	object.Color =
		purpleSequence(object.Color)

	tracked[object] = true
end

--============================================================
-- ĐỔI MÀU LIGHT
--============================================================

local function changeLight(object)

	if not (
		object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
	) then

		return
	end

	object.Color =
		CONFIG.LIGHT_PURPLE

	tracked[object] = true
end

--============================================================
-- ĐỔI MÀU HIGHLIGHT
--============================================================

local function changeHighlight(object)

	if not object:IsA("Highlight") then
		return
	end

	object.FillColor =
		CONFIG.PURPLE

	object.OutlineColor =
		CONFIG.LIGHT_PURPLE

	tracked[object] = true
end

--============================================================
-- HÀM ĐỔI MÀU CHÍNH
--============================================================

local function convertToPurple(object)

	if not object
		or not object.Parent then

		return
	end

	if isIgnored(object) then
		return
	end

	if not isNearPlayer(object) then
		return
	end

	if object:IsA("ParticleEmitter") then

		changeParticle(object)

	elseif object:IsA("Trail") then

		changeTrail(object)

	elseif object:IsA("Beam") then

		changeBeam(object)

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		changeLight(object)

	elseif object:IsA("Highlight") then

		changeHighlight(object)
	end
end

--============================================================
-- QUÉT TOÀN BỘ HIỆU ỨNG
--============================================================

local function scanWorkspace()

	local amount = 0

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if amount >= 1000 then
			break
		end

		if isColorEffect(object) then

			convertToPurple(object)

			amount += 1
		end
	end
end

--============================================================
-- HIỆU ỨNG MỚI XUẤT HIỆN
--============================================================

Workspace.DescendantAdded:Connect(
	function(object)

		if isColorEffect(object) then

			-- Chờ game hoàn thành việc thiết lập
			-- ParticleEmitter / Beam / Trail
			task.defer(function()

				convertToPurple(object)

			end)
		end
	end
)

--============================================================
-- CHARACTER ADDED
--============================================================

LocalPlayer.CharacterAdded:Connect(
	function()

		-- Không đổi nhân vật.
		-- Chỉ quét lại Workspace sau khi hồi sinh
		-- để bắt các effect bên ngoài nhân vật.

		task.wait(0.5)

		scanWorkspace()
	end
)

--============================================================
-- QUÉT LIÊN TỤC
--============================================================

task.spawn(function()

	while true do

		scanWorkspace()

		task.wait(
			CONFIG.SCAN_INTERVAL
		)
	end
end)

--============================================================
-- KIỂM TRA ĐỐI TƯỢNG ĐÃ BỊ XÓA
--============================================================

task.spawn(function()

	while true do

		for object in pairs(tracked) do

			if not object
				or not object.Parent then

				tracked[object] = nil
			else

				-- Ép lại màu.
				--
				-- Một số hệ thống hiệu ứng có thể
				-- tự đặt màu lại sau khi tạo.
				convertToPurple(object)
			end
		end

		task.wait(0.15)
	end
end)

--============================================================
-- KHỞI ĐỘNG NGAY
--============================================================

task.wait(0.2)

scanWorkspace()

print(
	"[ColorSwap v4.0] TẤT CẢ HIỆU ỨNG ĐÃ ĐƯỢC ÉP SANG TÍM."
)
