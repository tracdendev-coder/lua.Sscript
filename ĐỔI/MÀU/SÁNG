local DynamicScanner = {}

function DynamicScanner.ScanCharacter(char, isLocal)
    if not char then return end
    local groupTarget = isLocal and "NHÂN VẬT" or "NGƯỜI CHƠI KHÁC"
    
    if not isLocal and not CONFIG.ShowOtherPlayers then return end

    for _, v in ipairs(char:GetDescendants()) do
        DynamicScanner.EvaluateDescendant(v, groupTarget)
    end

    char.DescendantAdded:Connect(function(v)
        DynamicScanner.EvaluateDescendant(v, groupTarget)
    end)
end

function DynamicScanner.EvaluateDescendant(inst, groupFallback)
    local parentName = inst.Parent and inst.Parent.Name:lower() or ""
    local name = inst.Name:lower()

    if parentName:find("weapon") or parentName:find("sword") or parentName:find("gun") or inst:FindFirstAncestorOfClass("Tool") then
        PerformanceEngine.ClassifyAndRegister(inst, "VŨ KHÍ")
    elseif name:find("dash") or name:find("run") or name:find("step") or name:find("move") then
        PerformanceEngine.ClassifyAndRegister(inst, "HIỆU ỨNG DI CHUYỂN")
    elseif name:find("attack") or name:find("slash") or name:find("hit") or name:find("cut") then
        PerformanceEngine.ClassifyAndRegister(inst, "HIỆU ỨNG TẤN CÔNG")
    elseif name:find("skill") or name:find("fruit") or name:find("aura") or name:find("blast") or name:find("magic") then
        PerformanceEngine.ClassifyAndRegister(inst, "HIỆU ỨNG KỸ NĂNG")
    else
        PerformanceEngine.ClassifyAndRegister(inst, groupFallback or "NHÂN VẬT")
    end
end

-- Tự động Hook nhân vật khi hồi sinh
if LocalPlayer.Character then
    DynamicScanner.ScanCharacter(LocalPlayer.Character, true)
end

LocalPlayer.CharacterAdded:Connect(function(char)
