CreateSectionHeader("TÙY CHỈNH HIỂN THỊ (NO LAG)")

local BeliConnections = {}
local LevelConnections = {}

CreateInputField("Nhập số Beli ảo...", function(value)
    -- Clear cũ
    for _, conn in ipairs(BeliConnections) do conn:Disconnect() end
    table.clear(BeliConnections)

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return end

    local targetText = "$" .. value
    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("TextLabel") and (obj.Name == "Money" or obj.Name == "Beli" or (obj.Text:find("%$") and not obj:IsDescendantOf(ScreenGui))) then
            obj.Text = targetText
            -- Tự động khóa lại khi game thay đổi giá trị mà không tốn CPU
            local conn = obj:GetPropertyChangedSignal("Text"):Connect(function()
                if obj.Text ~= targetText then
                    obj.Text = targetText
                end
            end)
            table.insert(BeliConnections, conn)
        end
    end
end)

