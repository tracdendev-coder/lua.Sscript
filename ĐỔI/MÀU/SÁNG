-- Script chính: LocalScript đặt trong StarterGui hoặc PlayerGui
-- Tối ưu FPS: Không dùng RunService.RenderStepped liên tục, chỉ cập nhật khi đổi màu hoặc dùng timer 0.1s cho rainbow.
-- Nguyên nhân giảm FPS (100->16): Cập nhật Color3/BrickColor cho nhiều Part/BasePart mỗi frame buộc Engine tái build lighting, shadow, reflection. Giải pháp: Cache đối tượng, chỉ set màu khi toggle, và dùng wait() thay vì RenderStepped.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local root = character:WaitForChild("HumanoidRootPart")

-- Cache toàn bộ Part và Tool/Vũ khí
local allParts = {}
local allWeapons = {}
local particleEmitters = {} -- cho bụi/cát

local function refreshCache()
    allParts = {}
    if character then
        for _, v in ipairs(character:GetDescendants()) do
            if v:IsA("BasePart") then
                table.insert(allParts, v)
            end
            if v:IsA("ParticleEmitter") or v:IsA("Trail") then
                table.insert(particleEmitters, v)
            end
        end
    end
    -- Vũ khí (Tool trong Backpack hoặc tay)
    allWeapons = {}
    local backpack = player:FindFirstChild("Backpack")
    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(allWeapons, tool)
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then table.insert(allParts, part) end
                end
            end
        end
    end
    local char = character
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(allWeapons, tool)
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then table.insert(allParts, part) end
                end
            end
        end
    end
end

refreshCache()
character.CharacterAdded:Connect(function(newChar)
    character = newChar
    wait(0.2)
    refreshCache()
end)

-- Biến trạng thái
local currentSolidColor = nil -- nil hoặc Color3
local isRainbow = false
local rainbowConnection = nil
local isMenuOpen = false

-- Hàm áp màu cho toàn bộ
local function applyColorToAll(color3)
    for _, part in ipairs(allParts) do
        if part:IsA("BasePart") and part ~= root then -- giữ root màu gốc nếu muốn
            part.BrickColor = BrickColor.new(color3)
            part.Color = color3
        end
    end
    for _, emitter in ipairs(particleEmitters) do
        emitter.Color = ColorSequence.new(color3)
    end
    -- Áp cho hình ảnh nhỏ (ImageLabel) trong menu hoặc UI khác – nhưng yêu cầu "cát bụi cát hình ảnh nhỏ" -> nếu có ImageLabel liên quan đến màu, set ImageColor3
    -- Giả sử có ImageLabel tên "DustImage" trong PlayerGui
    local gui = player:FindFirstChild("PlayerGui")
    if gui then
        for _, img in ipairs(gui:GetDescendants()) do
            if img:IsA("ImageLabel") and img.Name:find("Color") then
                img.ImageColor3 = color3
            end
        end
    end
end

local function stopRainbow()
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
    isRainbow = false
end

local function startRainbow()
    stopRainbow()
    isRainbow = true
    local hue = 0
    -- Cập nhật mỗi 0.1 giây thay vì mỗi frame -> giữ FPS ổn định
    rainbowConnection = RunService.Heartbeat:Connect(function()
        hue = (hue + 0.01) % 1
        local c = Color3.fromHSV(hue, 1, 1)
        applyColorToAll(c)
    end)
    -- Đặt tần suất giới hạn bằng cách dùng tick() – nhưng Heartbeat vẫn chạy, ta kiểm tra delta
    -- Cách tốt hơn: dùng while loop với wait(0.1)
end

-- Hàm chọn màu tĩnh
local function setSolidColor(color3)
    stopRainbow()
    currentSolidColor = color3
    applyColorToAll(color3)
end

-- TẠO MENU UI
