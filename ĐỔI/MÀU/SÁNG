--============================================================
-- KIỂM TRA ĐỐI TƯỢNG
--============================================================

local function IsSupported(object)

	return object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
		or object:IsA("Highlight")
end

--============================================================
-- KHÔNG ĐỤNG VŨ KHÍ / CHARACTER
--============================================================

local function IsForbidden(object)

	local current = object

	while current and current ~= workspace do

		local name = string.lower(current.Name)

		-- Không xử lý thân nhân vật
		if current == Player.Character then
			return true
		end

		-- Không xử lý vũ khí
		if string.find(name, "weapon", 1, true)
			or string.find(name, "sword", 1, true)
			or string.find(name, "gun", 1, true)
			or string.find(name, "katana", 1, true)
			or string.find(name, "blade", 1, true) then

			return true
		end

		current = current.Parent
	end

	return false
end

--============================================================
-- ĐĂNG KÝ
--============================================================

local function Register(object)

	if not IsSupported(object) then
		return
	end

	if IsForbidden(object) then
		return
	end

	if Effects[object] then
		return
	end

	local count = 0

	for _ in pairs(Effects) do
		count += 1

		if count >= CONFIG.MaxEffects then
			return
		end
	end

	Effects[object] = true

	-- Lưu màu gốc
	if object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam") then

		OriginalColors[object] = object.Color

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		OriginalColors[object] = object.Color

	elseif object:IsA("Highlight") then

		OriginalColors[object] = {
			FillColor = object.FillColor,
			OutlineColor = object.OutlineColor,
		}
	end
end

--============================================================
-- QUÉT SÂU
--============================================================

local function DeepScan()

	local amount = 0

	for _, object in ipairs(workspace:GetDescendants()) do

		if amount >= CONFIG.MaxEffects then
			break
		end

		if IsSupported(object)
			and not IsForbidden(object) then

			Register(object)

			amount += 1
		end
	end
end

--============================================================
-- KIỂM TRA KHOẢNG CÁCH
--============================================================

local function IsNear(object)

	local character = Player.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local parent = object.Parent

	if parent and parent:IsA("BasePart") then

		return (
			parent.Position - root.Position
		).Magnitude <= CONFIG.CullingDistance

	end

	return true
end

--============================================================
-- TẠO MÀU CẦU VỒNG
--============================================================

local function GetRainbow()

	RainbowHue =
		(RainbowHue + 0.012) % 1

	return Color3.fromHSV(
		RainbowHue,
		1,
		1
	)
end

--============================================================
-- ĐỔI MÀU SÂU COLORSEQUENCE
--============================================================

local function ConvertSequence(sequence, targetColor)

	-- ÉP TOÀN BỘ THÀNH MỘT MÀU
	if CONFIG.ForceSolidColor then

		local keypoints = {}

		for _, keypoint in ipairs(
			sequence.Keypoints
		) do

			table.insert(
				keypoints,

				ColorSequenceKeypoint.new(
					keypoint.Time,
					targetColor
				)
			)
		end

		return ColorSequence.new(keypoints)
	end

	--========================================================
	-- CHẾ ĐỘ GIỮ ĐỘ SÁNG
	--========================================================

	local newKeypoints = {}

	for _, keypoint in ipairs(
		sequence.Keypoints
	) do

		local oldColor =
			keypoint.Value

		local _, _, value =
			oldColor:ToHSV()

		local saturation = 0.95

		local newColor =
			Color3.fromHSV(
				select(1, targetColor:ToHSV()),
				saturation,
				math.clamp(value, 0.35, 1)
			)

		table.insert(
			newKeypoints,

			ColorSequenceKeypoint.new(
				keypoint.Time,
				newColor
			)
		)
	end

	return ColorSequence.new(newKeypoints)
end

--============================================================
-- ÁP DỤNG MÀU 100%
--============================================================

local function ApplyDeepColor(object, color)

	if not object
		or not object.Parent then

		return
	end

	if not IsNear(object) then
		return
	end

	--========================================================
	-- PARTICLE
	--========================================================

	if object:IsA("ParticleEmitter") then

		object.Color =
			ConvertSequence(
				object.Color,
				color
			)

	--========================================================
	-- TRAIL
	--========================================================

	elseif object:IsA("Trail") then

		object.Color =
			ConvertSequence(
				object.Color,
				color
			)

	--========================================================
	-- BEAM
	--========================================================

	elseif object:IsA("Beam") then

		object.Color =
			ConvertSequence(
				object.Color,
				color
			)

	--========================================================
	-- LIGHT
	--========================================================

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		object.Color = color

	--========================================================
	-- HIGHLIGHT
	--========================================================

	elseif object:IsA("Highlight") then

		object.FillColor = color
		object.OutlineColor = color
	end
end

--============================================================
-- KHÔI PHỤC MÀU GỐC
--============================================================

local function RestoreOriginal()

	for object, original in pairs(
		OriginalColors
	) do

		if object
			and object.Parent then

			if object:IsA("ParticleEmitter")
				or object:IsA("Trail")
				or object:IsA("Beam") then

				object.Color = original

			elseif object:IsA("PointLight")
				or object:IsA("SpotLight")
				or object:IsA("SurfaceLight") then

				object.Color = original

			elseif object:IsA("Highlight") then

				object.FillColor =
					original.FillColor

				object.OutlineColor =
					original.OutlineColor
			end
		end
	end
end

--============================================================
-- CẬP NHẬT TOÀN BỘ
--============================================================

local function UpdateAll()

	local color

	if CurrentColor.Rainbow then
		color = GetRainbow()
	else
		color = CurrentColor.Value
	end

	for object in pairs(Effects) do

		if not object
			or not object.Parent then

			Effects[object] = nil

		else

			ApplyDeepColor(
				object,
				color
			)
		end
	end
end

