local Effects = {}

--============================================================
-- KIỂM TRA HIỆU ỨNG
--============================================================

local function IsEffect(object)

	if not object then
		return false
	end

	if object:IsA("ParticleEmitter") then
		return true
	end

	if object:IsA("Trail") then
		return true
	end

	if object:IsA("Beam") then
		return true
	end

	if object:IsA("PointLight") then
		return true
	end

	if object:IsA("SpotLight") then
		return true
	end

	if object:IsA("SurfaceLight") then
		return true
	end

	if CONFIG.AllowHighlight
		and object:IsA("Highlight") then

		return true
	end

	return false
end

--============================================================
-- KIỂM TRA HIỆU ỨNG CÓ PHẢI CỦA NHÂN VẬT KHÔNG
--============================================================

local function IsInsideCharacter(object)

	local character = LocalPlayer.Character

	if not character then
		return false
	end

	return object:IsDescendantOf(character)
end

--============================================================
-- KIỂM TRA TÊN
--============================================================

local KEYWORDS = {

	"effect",
	"effects",

	"particle",
	"particles",

	"dust",

	"sand",

	"bullet",

	"projectile",

	"trail",

	"beam",

	"slash",

	"hit",

	"impact",

	"skill",

	"ability",

	"attack",

}

local function HasEffectName(object)

	local name =
		string.lower(object.Name)

	for _, keyword in ipairs(KEYWORDS) do

		if string.find(
			name,
			keyword,
			1,
			true
		) then

			return true
		end

	end

	return false
end

--============================================================
-- ĐĂNG KÝ
--============================================================

local function Register(object)

	if not IsEffect(object) then
		return
	end

	if Effects[object] then
		return
	end

	-- Không lấy Highlight/hiệu ứng linh tinh nếu không
	-- nằm trong Character hoặc có tên hiệu ứng.

	if not IsInsideCharacter(object)
		and not HasEffectName(object) then

		return
	end

	local total = 0

	for _ in pairs(Effects) do

		total += 1

		if total >= CONFIG.MaxEffects then
			return
		end

	end

	Effects[object] = true

	object.Destroying:Connect(function()

		Effects[object] = nil

	end)

end

--============================================================
-- QUÉT
--============================================================

local function Scan()

	local character =
		LocalPlayer.Character

	if character then

		for _, object in ipairs(
			character:GetDescendants()
		) do

			Register(object)

		end

	end

	-- Chỉ lấy hiệu ứng ngoài Character
	-- khi tên có dấu hiệu rõ ràng.

	local total = 0

	for _, object in ipairs(
		workspace:GetDescendants()
	) do

		if total >= CONFIG.MaxEffects then
			break
		end

		if IsEffect(object)
			and HasEffectName(object) then

			Register(object)

			total += 1

		end

	end

end

--============================================================
-- KHOẢNG CÁCH
--============================================================

local function IsNear(object)

	local character =
		LocalPlayer.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return false
	end

	local parent = object.Parent

	if parent
		and parent:IsA("BasePart") then

		local distance =
			(parent.Position - root.Position).Magnitude

		return distance <=
			CONFIG.CullingDistance

	end

	return true
end

--============================================================
-- TẠO COLOR SEQUENCE 1 MÀU
--
-- Đây là phần quan trọng nhất.
--
-- Thay vì:
--
-- Đỏ -> Hồng
--
-- nhưng giữ:
--
-- đỏ -> cam -> vàng
--
-- ta tạo:
--
-- Hồng -> Hồng -> Hồng
--
--============================================================

local function CreatePureColorSequence(color)

	if not CONFIG.DeepColorMode then

		return ColorSequence.new(color)

	end

	return ColorSequence.new({

		ColorSequenceKeypoint.new(
			0,
			color
		),

		ColorSequenceKeypoint.new(
			0.25,
			color
		),

		ColorSequenceKeypoint.new(
			0.5,
			color
		),

		ColorSequenceKeypoint.new(
			0.75,
			color
		),

		ColorSequenceKeypoint.new(
			1,
			color
		),

	})

end

--============================================================
-- CHUYỂN MÀU PARTICLE
--============================================================

local function ChangeParticle(
	object,
	color
)

	if object:IsA("ParticleEmitter") then

		object.Color =
			CreatePureColorSequence(color)

	end

end

--============================================================
-- CHUYỂN MÀU TRAIL
--============================================================

local function ChangeTrail(
	object,
	color
)

	if object:IsA("Trail") then

		object.Color =
			CreatePureColorSequence(color)

	end

end

--============================================================
-- CHUYỂN MÀU BEAM
--============================================================

local function ChangeBeam(
	object,
	color
)

	if object:IsA("Beam") then

		object.Color =
			CreatePureColorSequence(color)

	end

end

--============================================================
-- CHUYỂN MÀU LIGHT
--============================================================

local function ChangeLight(
	object,
	color
)

	if object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		object.Color = color

	end

end

--============================================================
-- CHUYỂN MÀU HIGHLIGHT
--============================================================

local function ChangeHighlight(
	object,
	color
)

	if not CONFIG.AllowHighlight then
		return
	end

	if not object:IsA("Highlight") then
		return
	end

	object.FillColor = color

	object.OutlineColor = color

end

--============================================================
-- ÁP DỤNG MÀU SÂU
--============================================================

local function ApplyDeepColor(
	object,
	color
)

	if not object
		or not object.Parent then

		return
	end

	if not IsNear(object) then
		return
	end

	ChangeParticle(
		object,
		color
	)

	ChangeTrail(
		object,
		color
	)

	ChangeBeam(
		object,
		color
	)

	ChangeLight(
		object,
		color
	)

	ChangeHighlight(
		object,
		color
	)

end

--============================================================
-- CẦU VỒNG
--============================================================

local function GetRainbowColor()

	RainbowHue =
		(
			RainbowHue
			+ CONFIG.UpdateRate
				* 0.15
		) % 1

	return Color3.fromHSV(
		RainbowHue,
		0.9,
		1
	)

end

--============================================================
-- LẤY MÀU
--============================================================

local function GetCurrentColor()

	if CurrentColor.Rainbow then

		return GetRainbowColor()

	end

	return CurrentColor.Value

end

--============================================================
-- ÁP DỤNG TOÀN BỘ
--============================================================

local function ApplyToAll()

	local color =
		GetCurrentColor()

	for object in pairs(Effects) do

		if object
			and object.Parent then

			ApplyDeepColor(
				object,
				color
			)

		else

			Effects[object] = nil

		end

	end

end

--============================================================
-- HIỆU ỨNG MỚI
--============================================================

workspace.DescendantAdded:Connect(
	function(object)

		if IsEffect(object) then

			task.defer(function()

				Register(object)

				if CurrentColor then
					ApplyDeepColor(
						object,
						GetCurrentColor()
					)
				end

			end)

		end

	end
)

