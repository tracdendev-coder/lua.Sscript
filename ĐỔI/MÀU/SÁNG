-- ============================================================================
-- CORE EFFECT ENGINE (PARTICLE MODIFIER FOR WORLD/SKILLS/DUST)
-- ============================================================================

local function IsSelfOrWorldEffect(descendant)
    -- Exclude all players including weapons/swords
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and descendant:IsDescendantOf(player.Character) then
            return false
        end
    end
    return true
end

local function ApplyColorToParticle(particle, targetColor)
    if particle:IsA("ParticleEmitter") then
        particle.Color = ColorSequence.new(targetColor)
    elseif particle:IsA("PointLight") or particle:IsA("SpotLight") or particle:IsA("SurfaceLight") then
        particle.Color = targetColor
    end
end

-- Runtime Tick
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    if not ColorConfig.Enabled then return end

    -- Compute dynamic color state
    local currentColor = ColorConfig.SelectedColor
    if ColorConfig.CurrentMode == "Rainbow" then
        hue = (hue + dt * 0.4) % 1
        currentColor = Color3.fromHSV(hue, 0.9, 1)
    end

    -- Process game particles dynamically (effects, dust, skill impact)
    for _, obj in pairs(workspace:GetDescendants()) do
        if (obj:IsA("ParticleEmitter") or obj:IsA("Light")) and IsSelfOrWorldEffect(obj) then
            ApplyColorToParticle(obj, currentColor)
        end
    end
end)

-- Window Resize Logic
local isMinimized = false
ToggleSizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        MainFrame:TweenSize(UDim2.new(0, 360, 0, 40), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
        ScrollContainer.Visible = false
        ToggleSizeBtn.Text = "+"
    else
        MainFrame:TweenSize(UDim2.new(0, 360, 0, 420), Enum.EasingDirection.Out, Enum.EasingStyle.Quart, 0.2, true)
        ScrollContainer.Visible = true
        ToggleSizeBtn.Text = "-"
    end
end)

