--==================================================
-- PURE COLOR
--==================================================

local function PureSequence(color)
	if not CONFIG.DeepColor then
		return ColorSequence.new(color)
	end

	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(0.25, color),
		ColorSequenceKeypoint.new(0.5, color),
		ColorSequenceKeypoint.new(0.75, color),
		ColorSequenceKeypoint.new(1, color),
	})
end

--==================================================
-- APPLY COLOR
--==================================================

local function ApplyColor(obj, color)
	if not obj or not obj.Parent then
		return
	end

	-- Particle
	if obj:IsA("ParticleEmitter") then
		pcall(function()
			obj.Color = PureSequence(color)
		end)
	end

	-- Trail
	if obj:IsA("Trail") then
		pcall(function()
			obj.Color = PureSequence(color)
		end)
	end

	-- Beam
	if obj:IsA("Beam") then
		pcall(function()
			obj.Color = PureSequence(color)
		end)
	end

	-- Lights
	if obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		pcall(function()
			obj.Color = color
		end)
	end

	-- Highlight
	if obj:IsA("Highlight") then
		pcall(function()
			obj.FillColor = color
			obj.OutlineColor = color
		end)
	end
end

--==================================================
-- SCAN
--==================================================

local function ScanEffects()
	local character = Player.Character

	if character then
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("ParticleEmitter")
				or obj:IsA("Trail")
				or obj:IsA("Beam")
				or obj:IsA("PointLight")
				or obj:IsA("SpotLight")
				or obj:IsA("SurfaceLight")
				or obj:IsA("Highlight") then

				if rainbowEnabled then
					local rainbowColor =
						Color3.fromHSV(rainbowHue, 1, 1)

					ApplyColor(obj, rainbowColor)
				else
					ApplyColor(obj, currentColor.Color)
				end
			end
		end
	end
end

