-- Dynamic Rainbow Loop
local hue = 0
RunService.RenderStepped:Connect(function(dt)
    if not ColorConfig.Enabled then return end

    if ColorConfig.CurrentMode == "Rainbow" then
        hue = (hue + dt * ColorConfig.RainbowSpeed) % 1
        ApplyColor(Color3.fromHSV(hue, 0.9, 1))
    end
end)

task.spawn(function()
    while true do
        task.wait(0.2)
        if ColorConfig.Enabled and ColorConfig.CurrentMode ~= "Rainbow" then
            ApplyColor(ColorConfig.SelectedColor)
        end
    end
end)

