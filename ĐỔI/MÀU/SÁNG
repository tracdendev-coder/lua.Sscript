-- 4. BỘ CẬP NHẬT CHU KỲ FRAME & CẦU VỒNG (BATCH RENDER ENGINE)
--------------------------------------------------------------------------------

local RenderBatch = {
    Accumulator = 0,
    Hue = 0
}

RunService.Heartbeat:Connect(function(dt)
    -- Xử lý thông số FPS
    FPSMetrics.CurrentFPS = math.floor(1 / dt)
    table.insert(FPSMetrics.FrameHistory, FPSMetrics.CurrentFPS)
    if #FPSMetrics.FrameHistory > 60 then
        table.remove(FPSMetrics.FrameHistory, 1)
    end
    
    local sum = 0
    for _, v in ipairs(FPSMetrics.FrameHistory) do sum = sum + v end
    FPSMetrics.AverageFPS = math.floor(sum / #FPSMetrics.FrameHistory)

    -- Tự động hạ cấp hiệu ứng khi FPS chạm ngưỡng nguy hiểm
    if CONFIG.AutoOptimize and (os.clock() - FPSMetrics.LastOptimized > 3) then
        FPSMetrics.LastOptimized = os.clock()
        if FPSMetrics.AverageFPS < 30 then
            CONFIG.QualityLevel = "TIẾT KIỆM FPS"
        elseif FPSMetrics.AverageFPS > 50 and CONFIG.QualityLevel == "TIẾT KIỆM FPS" then
            CONFIG.QualityLevel = "CÂN BẰNG"
        end
    end

    -- Giới hạn tần suất Cập Nhật Màu theo Cấu Hình Hiệu Năng để bảo đảm FPS
    local targetInterval = 0.033 -- Mặc định ~30 FPS Render Rate
    if CONFIG.QualityLevel == "CAO" then
        targetInterval = 0.016 -- ~60 FPS
    elseif CONFIG.QualityLevel == "CÂN BẰNG" then
        targetInterval = 0.05 -- ~20 FPS
    elseif CONFIG.QualityLevel == "TIẾT KIỆM FPS" then
        targetInterval = 0.1 -- ~10 FPS
    end

    RenderBatch.Accumulator = RenderBatch.Accumulator + dt
    if RenderBatch.Accumulator < targetInterval then return end
    RenderBatch.Accumulator = 0

    -- Tính toán Hue cho Cầu Vồng
    RenderBatch.Hue = (RenderBatch.Hue + (dt * CONFIG.RainbowSpeed * 0.2)) % 1
    local currentRainbowColor = Color3.fromHSV(RenderBatch.Hue, 1, 1)

    -- Duyệt Batch duy nhất cho toàn bộ Object được lưu
    for inst, data in pairs(ManagedObjects) do
        if inst and inst.Parent then
            local grp = data.Group
            local grpConfig = CONFIG.Groups[grp]
            
            if grpConfig and grpConfig.Active then
                local isGlobalRainbow = (CONFIG.RainbowMode ~= "OFF")
                local isGroupRainbow = grpConfig.Rainbow
                
                if isGlobalRainbow or isGroupRainbow then
                    PerformanceEngine.ApplyColorToObject(inst, currentRainbowColor)
                else
                    local chosenColorName = CONFIG.ApplyToAll and CONFIG.GlobalColor or grpConfig.Color
                    if chosenColorName == "Cầu Vồng" then
                        PerformanceEngine.ApplyColorToObject(inst, currentRainbowColor)
                    else
                        -- Tối ưu: Chỉ set màu nếu chưa gắn đúng
                        PerformanceEngine.ApplyColorToObject(inst, COLOR_PALETTE[chosenColorName])
                    end
                end
            end
        else
            PerformanceEngine.UnregisterInstance(inst)
        end
    end
end)

