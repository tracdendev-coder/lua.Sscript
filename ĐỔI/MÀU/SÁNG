--==================================================
-- RAINBOW LOOP
--==================================================

local timer = 0

RunService.Heartbeat:Connect(function(dt)
	timer += dt

	if timer >= CONFIG.ScanInterval then
		timer = 0

		if rainbowEnabled then
			rainbowHue =
				(rainbowHue + CONFIG.RainbowSpeed * CONFIG.ScanInterval)
				% 1

			ScanEffects()
		end
	end
end)

