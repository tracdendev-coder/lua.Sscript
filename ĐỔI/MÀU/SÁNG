--==================================================
-- BIẾN
--==================================================

local CurrentColor = COLORS[6]
local Rainbow = false
local RainbowHue = 0

local Gui
local Main
local Open = false

--==================================================
-- RAINBOW
--==================================================

local function GetCurrentColor()

    if Rainbow then
        RainbowHue = (RainbowHue + 0.004) % 1

        return Color3.fromHSV(
            RainbowHue,
            1,
            1
        )
    end

    return CurrentColor.Value
end

--==================================================
-- PURE COLOR SEQUENCE
--==================================================

local function PureColorSequence(Color)

    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color),
        ColorSequenceKeypoint.new(0.25, Color),
        ColorSequenceKeypoint.new(0.5, Color),
        ColorSequenceKeypoint.new(0.75, Color),
        ColorSequenceKeypoint.new(1, Color),
    })

end

--==================================================
-- KHOẢNG CÁCH
--==================================================

local function InRange(Object)

    local Camera = workspace.CurrentCamera

    if not Camera then
        return true
    end

    local Part = Object:IsA("BasePart")
        and Object
        or Object:FindFirstAncestorWhichIsA("BasePart")

    if not Part then
        return true
    end

    return (
        Part.Position - Camera.CFrame.Position
    ).Magnitude <= CONFIG.MaxDistance

end

--==================================================
-- PARTICLE
--==================================================

local function ChangeParticle(Object, Color)

    if not Object:IsA("ParticleEmitter") then
        return
    end

    pcall(function()

        Object.Color = PureColorSequence(Color)

    end)

end

--==================================================
-- TRAIL
--==================================================

local function ChangeTrail(Object, Color)

    if not Object:IsA("Trail") then
        return
    end

    pcall(function()

        Object.Color = PureColorSequence(Color)

    end)

end

--==================================================
-- BEAM
--==================================================

local function ChangeBeam(Object, Color)

    if not Object:IsA("Beam") then
        return
    end

    pcall(function()

        Object.Color = PureColorSequence(Color)

    end)

end

--==================================================
-- LIGHT
--==================================================

local function ChangeLight(Object, Color)

    if not (
        Object:IsA("PointLight")
        or Object:IsA("SpotLight")
        or Object:IsA("SurfaceLight")
    ) then
        return
    end

    pcall(function()

        Object.Color = Color

    end)

end

--==================================================
-- HIGHLIGHT
--==================================================

local function ChangeHighlight(Object, Color)

    if not Object:IsA("Highlight") then
        return
    end

    pcall(function()

        Object.FillColor = Color
        Object.OutlineColor = Color

    end)

end

--==================================================
-- ĐỔI MÀU SÂU
--==================================================

local function ApplyDeepColor(Object, Color)

    if not Object
        or not Object.Parent
        or not InRange(Object) then
        return
    end

    ChangeParticle(Object, Color)
    ChangeTrail(Object, Color)
    ChangeBeam(Object, Color)
    ChangeLight(Object, Color)
    ChangeHighlight(Object, Color)

end

--==================================================
-- SCAN TOÀN BỘ HIỆU ỨNG
--==================================================

local function ScanEffects()

    local Color = GetCurrentColor()

    -- Character local
    local Character = LocalPlayer.Character

    if Character then

        for _, Object in ipairs(
            Character:GetDescendants()
        ) do

            ApplyDeepColor(Object, Color)

        end

    end

    -- Workspace effects
    for _, Object in ipairs(
        workspace:GetDescendants()
    ) do

        if Object:IsA("ParticleEmitter")
            or Object:IsA("Trail")
            or Object:IsA("Beam")
            or Object:IsA("PointLight")
            or Object:IsA("SpotLight")
            or Object:IsA("SurfaceLight")
            or Object:IsA("Highlight") then

            ApplyDeepColor(Object, Color)

        end

    end

end

--==================================================
-- GUI
--==================================================

local function CreateMenu()

    if Gui then
        Gui.Enabled = true
        return
    end

    Gui = Instance.new("ScreenGui")
    Gui.Name = "ColorSwapMenu"
    Gui.ResetOnSpawn = false
    Gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    Main = Instance.new("Frame")
    Main.Size = UDim2.fromOffset(330, 390)
    Main.Position = UDim2.new(
        0.5,
        -165,
        0.5,
        -195
    )

    Main.BackgroundColor3 =
        Color3.fromRGB(20, 20, 25)

    Main.BorderSizePixel = 0
    Main.Parent = Gui

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(0, 14)

    Corner.Parent = Main

    --==================================================
    -- TITLE
    --==================================================

    local Title =
        Instance.new("TextLabel")

    Title.Size =
        UDim2.new(1, -20, 0, 45)

    Title.Position =
