-- RESIZE HANDLE
--==================================================

local Resize = Instance.new("TextButton")
Resize.Size = UDim2.fromOffset(22, 22)
Resize.Position = UDim2.new(1, -24, 1, -24)
Resize.BackgroundTransparency = 1
Resize.Text = "◢"
Resize.TextColor3 = Color3.fromRGB(170, 170, 180)
Resize.TextSize = 16
Resize.Parent = Main

local resizing = false
local resizeStart
local originalSize

Resize.MouseButton1Down:Connect(function()
	resizing = true
	resizeStart = UserInputService:GetMouseLocation()
	originalSize = Main.AbsoluteSize
end)

UserInputService.InputChanged:Connect(function(input)
	if not resizing then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement then
		local mouse = UserInputService:GetMouseLocation()
		local delta = mouse - resizeStart

		local newX = math.clamp(
			originalSize.X + delta.X,
			CONFIG.MinSize.X,
			CONFIG.MaxSize.X
		)

		local newY = math.clamp(
			originalSize.Y + delta.Y,
			CONFIG.MinSize.Y,
			CONFIG.MaxSize.Y
		)

		Main.Size = UDim2.fromOffset(newX, newY)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		resizing = false
	end
end)

