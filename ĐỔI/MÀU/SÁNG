-- ScrollingFrame chứa danh sách màu
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(1, -10, 1, -40)
scrollFrame.Position = UDim2.new(0, 5, 0, 35)
scrollFrame.BackgroundTransparency = 1
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollFrame.ScrollBarThickness = 6
scrollFrame.Parent = mainFrame

local colorList = {
    {"Đỏ", Color3.fromRGB(255,0,0)},
    {"Hồng", Color3.fromRGB(255,105,180)},
    {"Cam", Color3.fromRGB(255,165,0)},
    {"Vàng", Color3.fromRGB(255,255,0)},
    {"Xanh lá", Color3.fromRGB(0,255,0)},
    {"Xanh dương", Color3.fromRGB(0,0,255)},
    {"Tím", Color3.fromRGB(128,0,128)},
    {"Trắng", Color3.fromRGB(255,255,255)},
    {"Đen", Color3.fromRGB(0,0,0)},
    {"Xám", Color3.fromRGB(128,128,128)}
}

local buttons = {}
local canvasY = 0
for _, data in ipairs(colorList) do
    local name = data[1]
    local col = data[2]
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 35)
    btn.Position = UDim2.new(0, 5, 0, canvasY)
    btn.Text = name
    btn.BackgroundColor3 = col
    btn.TextColor3 = (col.R + col.G + col.B > 1.5) and Color3.new(0,0,0) or Color3.new(1,1,1)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.new(1,1,1)
    btn.Parent = scrollFrame
    -- Lưu màu
    btn.UserData = col
    table.insert(buttons, btn)
    canvasY = canvasY + 40
    btn.MouseButton1Click:Connect(function()
        setSolidColor(col)
        -- Tắt chế độ rainbow nếu đang bật
    end)
end

-- Nút Rainbow đặc biệt
local rainbowBtn = Instance.new("TextButton")
rainbowBtn.Size = UDim2.new(1, -10, 0, 35)
rainbowBtn.Position = UDim2.new(0, 5, 0, canvasY)
rainbowBtn.Text = "🌈 Cầu vồng (hiệu ứng đổi màu)"
rainbowBtn.BackgroundColor3 = Color3.fromRGB(100,100,255)
rainbowBtn.TextColor3 = Color3.new(1,1,1)
rainbowBtn.Parent = scrollFrame
table.insert(buttons, rainbowBtn)
canvasY = canvasY + 40
rainbowBtn.MouseButton1Click:Connect(function()
    if isRainbow then
        stopRainbow()
        -- Quay về màu hiện tại hoặc mặc định
        if currentSolidColor then
            applyColorToAll(currentSolidColor)
        else
            applyColorToAll(Color3.fromRGB(255,255,255))
        end
    else
        startRainbow()
    end
end)

-- Cập nhật canvas size
scrollFrame.CanvasSize = UDim2.new(0, 0, 0, canvasY + 20)

-- Nút thu nhỏ/phóng to
local resizeBtn = Instance.new("TextButton")
resizeBtn.Size = UDim2.new(0, 30, 0, 30)
resizeBtn.Position = UDim2.new(1, -35, 0, 5)
resizeBtn.Text = "─"
resizeBtn.BackgroundColor3 = Color3.fromRGB(50,50,50)
resizeBtn.TextColor3 = Color3.new(1,1,1)
resizeBtn.Parent = mainFrame

local isMinimized = false
resizeBtn.MouseButton1Click:Connect(function()
    isMinimized = not isMinimized
    if isMinimized then
        mainFrame.Size = UDim2.new(0, 300, 0, 50)
        scrollFrame.Visible = false
        resizeBtn.Text = "➕"
    else
        mainFrame.Size = UDim2.new(0, 300, 0, 400)
        scrollFrame.Visible = true
        resizeBtn.Text = "─"
    end
end)

-- Toggle mở/đóng menu
toggleBtn.MouseButton1Click:Connect(function()
    isMenuOpen = not isMenuOpen
    mainFrame.Visible = isMenuOpen
end)

-- Kéo menu bằng chuột (tùy chọn)
local dragging = false
local dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)
mainFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Áp màu mặc định trắng khi khởi động
setSolidColor(Color3.fromRGB(255,255,255))

-- Ghi chú tối ưu: 
