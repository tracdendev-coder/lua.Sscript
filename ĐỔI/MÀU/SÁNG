-- Hook Workspace theo dõi kỹ năng / hiệu ứng mới xuất hiện
workspace.ChildAdded:Connect(function(child)
    if not CONFIG.Groups["HIỆU ỨNG KỸ NĂNG"].Active then return end
    
    -- Tối ưu tầm xa: Không xử lý hiệu ứng phát sinh cách quá 200 studs
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        if child:IsA("Model") or child:IsA("BasePart") then
            local pos = child:IsA("BasePart") and child.Position or child:GetPivot().Position
            if (pos - hrp.Position).Magnitude > 200 then
                return -- Bỏ qua đối tượng ở quá xa
            end
        end
    end

    task.wait()
    for _, inst in ipairs(child:GetDescendants()) do
        DynamicScanner.EvaluateDescendant(inst, "HIỆU ỨNG KỸ NĂNG")
    end
end)

