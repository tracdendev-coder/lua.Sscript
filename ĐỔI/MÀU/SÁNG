--============================================================
-- ColorSwap v4.0
-- TÍM TRỨNG 100%
--
-- Không menu
-- Không GUI
-- Không tạo Part mới
-- Không tạo bụi mới
-- Không can thiệp vũ khí
-- Không thay đổi nhân vật
-- Không ảnh hưởng server/người chơi khác
-- Tối ưu FPS
--============================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Player = Players.LocalPlayer

--============================================================
-- CẤU HÌNH TỐI ƯU
--============================================================

local CONFIG = {
	-- Tím trứng chính
	PurpleEgg = Color3.fromRGB(155, 70, 255),

	-- Tím sáng cho hiệu ứng phát sáng
	PurpleLight = Color3.fromRGB(180, 95, 255),

	-- Chỉ xử lý hiệu ứng ở gần người chơi
	MaxDistance = 150,

	-- Quét mới mỗi 1 giây
	ScanRate = 1,

	-- Đổi màu cực ít lần/giây
	-- Không dùng RenderStepped liên tục
	UpdateRate = 0.12,

	-- Giới hạn hiệu ứng để bảo vệ FPS
	MaxEffects = 180,
}

--============================================================
-- CACHE
--============================================================

local Effects = {}
local EffectCount = 0

--============================================================
-- KIỂM TRA ĐỐI TƯỢNG
--============================================================

local function IsColorEffect(obj)

	return obj:IsA("ParticleEmitter")
		or obj:IsA("Trail")
		or obj:IsA("Beam")
		or obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight")
end

--============================================================
-- LẤY VỊ TRÍ HIỆU ỨNG
--============================================================

local function GetPosition(obj)

	local parent = obj.Parent

	if parent and parent:IsA("BasePart") then
		return parent.Position
	end

	if parent and parent:IsA("Attachment") then

		local part = parent.Parent

		if part and part:IsA("BasePart") then
			return part.Position
		end
	end

	return nil
end

--============================================================
-- CULLING
--============================================================

local function IsNearPlayer(obj)

	local character = Player.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local position = GetPosition(obj)

	-- Không lấy được vị trí thì bỏ qua
	if not position then
		return false
	end

	local distance =
		(position - root.Position).Magnitude

	return distance <= CONFIG.MaxDistance
end

--============================================================
-- ĐĂNG KÝ
--============================================================

local function Register(obj)

	if EffectCount >= CONFIG.MaxEffects then
		return
	end

	if Effects[obj] then
		return
	end

	if not IsColorEffect(obj) then
		return
	end

	Effects[obj] = true
	EffectCount += 1
end

--============================================================
-- QUÉT HIỆU ỨNG
--============================================================

local function Scan()

	-- Ưu tiên hiệu ứng trong nhân vật
	local character = Player.Character

	if character then

		for _, obj in ipairs(
			character:GetDescendants()
		) do

			if IsColorEffect(obj) then
				Register(obj)
			end
		end
	end

	-- Sau đó mới kiểm tra Workspace
	for _, obj in ipairs(
		workspace:GetDescendants()
	) do

		if EffectCount >= CONFIG.MaxEffects then
			break
		end

		if IsColorEffect(obj)
			and IsNearPlayer(obj) then

			Register(obj)
		end
	end
end

--============================================================
-- DỌN CACHE
--============================================================

local function Clean()

	for obj in pairs(Effects) do

		if not obj
			or not obj.Parent then

			Effects[obj] = nil
			EffectCount -= 1
		end
	end

	if EffectCount < 0 then
		EffectCount = 0
	end
end

--============================================================
-- ÁP DỤNG TÍM 100%
--============================================================

local function ApplyPurple(obj)

	if not obj
		or not obj.Parent then
		return
	end

	if not IsNearPlayer(obj) then
		return
	end

	-- PARTICLE
	if obj:IsA("ParticleEmitter") then

		obj.Color =
			ColorSequence.new(
				CONFIG.PurpleEgg
			)

	-- TRAIL
	elseif obj:IsA("Trail") then

		obj.Color =
			ColorSequence.new(
				CONFIG.PurpleEgg
			)

	-- BEAM
	elseif obj:IsA("Beam") then

		obj.Color =
			ColorSequence.new(
				CONFIG.PurpleEgg
			)

	-- LIGHT
	elseif obj:IsA("PointLight")
		or obj:IsA("SpotLight")
		or obj:IsA("SurfaceLight") then

		obj.Color =
			CONFIG.PurpleLight
	end
end

--============================================================
-- ĐỔI MÀU TOÀN BỘ CACHE
--============================================================

local function Update()

	for obj in pairs(Effects) do

		if obj and obj.Parent then
			ApplyPurple(obj)
		end
	end
end

--============================================================
-- HIỆU ỨNG MỚI XUẤT HIỆN
--============================================================

workspace.DescendantAdded:Connect(function(obj)

	if IsColorEffect(obj) then

		-- Không xử lý ngay lập tức hàng loạt
		task.defer(function()

			if IsNearPlayer(obj) then
				Register(obj)
				ApplyPurple(obj)
			end

		end)
	end
end)

--============================================================
-- KHI NHÂN VẬT HỒI SINH
--============================================================

Player.CharacterAdded:Connect(function(character)

	task.wait(0.5)

	for _, obj in ipairs(
		character:GetDescendants()
	) do

		if IsColorEffect(obj) then
			Register(obj)
		end
	end

	Update()
end)

--============================================================
-- QUÉT ĐỊNH KỲ
--============================================================

task.spawn(function()

	while true do

		Clean()
		Scan()

		task.wait(CONFIG.ScanRate)
	end
end)

--============================================================
-- CẬP NHẬT MÀU
--============================================================

task.spawn(function()

	while true do

		Update()

		task.wait(CONFIG.UpdateRate)
	end
end)

--============================================================
-- KHỞI ĐỘNG NGAY
--============================================================

task.wait(0.5)

Scan()
Update()

print("ColorSwap v4.0: TÍM TRỨNG 100% đã bật.")
