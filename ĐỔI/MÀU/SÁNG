--============================================================
-- KIỂM TRA TÊN HIỆU ỨNG
--============================================================

local function isValidEffect(object)

	if not object then
		return false
	end

	if not (
		object:IsA("ParticleEmitter")
		or object:IsA("Trail")
		or object:IsA("Beam")
		or object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight")
	) then
		return false
	end

	local name = string.lower(object.Name)

	for _, keyword in ipairs(CONFIG.EffectKeywords) do

		if string.find(name, keyword, 1, true) then
			return true
		end
	end

	return false
end

--============================================================
-- ĐĂNG KÝ HIỆU ỨNG
--============================================================

local function registerEffect(object)

	if #EffectCache >= CONFIG.MaxEffects then
		return
	end

	if not isValidEffect(object) then
		return
	end

	if EffectCache[object] then
		return
	end

	EffectCache[object] = true
end

--============================================================
-- QUÉT HIỆU ỨNG
--============================================================

local function scanEffects()

	local count = 0

	for _, object in ipairs(workspace:GetDescendants()) do

		if count >= CONFIG.MaxEffects then
			break
		end

		if isValidEffect(object) then

			registerEffect(object)
			count += 1

		end
	end
end

--============================================================
-- DỌN CACHE
--============================================================

local function cleanCache()

	for object in pairs(EffectCache) do

		if not object
			or not object.Parent then

			EffectCache[object] = nil
		end
	end
end

--============================================================
-- CẦU VỒNG
--============================================================

local function getRainbowColor()

	rainbowHue =
		(rainbowHue + CONFIG.RainbowSpeed * 0.01) % 1

	return Color3.fromHSV(
		rainbowHue,
		0.9,
		1
	)
end

--============================================================
-- LẤY MÀU
--============================================================

local function getColor()

	if currentColor.Rainbow then
		return getRainbowColor()
	end

	return currentColor.Value
end

--============================================================
-- KIỂM TRA KHOẢNG CÁCH
--============================================================

local function isNearPlayer(object)

	local character = LocalPlayer.Character

	if not character then
		return false
	end

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return false
	end

	local parent = object.Parent

	if parent and parent:IsA("BasePart") then

		return (
			parent.Position - root.Position
		).Magnitude <= CONFIG.CullingDistance

	end

	return true
end

--============================================================
-- ĐỔI MÀU HIỆU ỨNG
--============================================================

local function applyColor(object, color)

	if not object or not object.Parent then
		return
	end

	if not isNearPlayer(object) then
		return
	end

	if object:IsA("ParticleEmitter") then

		object.Color =
			ColorSequence.new(color)

	elseif object:IsA("Trail") then

		object.Color =
			ColorSequence.new(color)

	elseif object:IsA("Beam") then

		object.Color =
			ColorSequence.new(color)

	elseif object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		object.Color = color
	end
end

--============================================================
-- CẬP NHẬT TOÀN BỘ
--============================================================

local function updateEffects()

	local color = getColor()

	for object in pairs(EffectCache) do

		if object
			and object.Parent then

			applyColor(object, color)

		else

			EffectCache[object] = nil
		end
	end
end

--============================================================
-- THEO DÕI HIỆU ỨNG MỚI
--============================================================

workspace.DescendantAdded:Connect(function(object)

	if isValidEffect(object) then

		task.defer(function()
			registerEffect(object)
		end)

	end
end)

--============================================================
-- GIAO DIỆN
--============================================================

local function create(className, properties)

	local object = Instance.new(className)

	for property, value in pairs(properties) do
		object[property] = value
	end

	return object
end

