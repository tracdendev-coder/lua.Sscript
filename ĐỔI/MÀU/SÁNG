-- 2. LÒNG TÓI UƯU VÀ XỬ LÝ HIỆU NĂNG (CORE OPTIMIZATION ENGINE)
--------------------------------------------------------------------------------

local PerformanceEngine = {}

function PerformanceEngine.GetColorValue(colorName, hueShift)
    if colorName == "Cầu Vồng" or colorName == "RAINBOW" then
        return Color3.fromHSV(hueShift or ((os.clock() * CONFIG.RainbowSpeed % 5) / 5), 1, 1)
    end
    return COLOR_PALETTE[colorName] or Color3.fromRGB(255, 255, 255)
end

function PerformanceEngine.ApplyColorToObject(inst, colorVal)
    if not inst or not inst.Parent then return end
    
    pcall(function()
        if inst:IsA("ParticleEmitter") then
            inst.Color = ColorSequence.new(colorVal)
        elseif inst:IsA("Trail") then
            inst.Color = ColorSequence.new(colorVal)
        elseif inst:IsA("Beam") then
            inst.Color = ColorSequence.new(colorVal)
        elseif inst:IsA("Highlight") then
            inst.FillColor = colorVal
            inst.OutlineColor = colorVal
        elseif inst:IsA("Light") then -- PointLight, SpotLight, SurfaceLight
            inst.Color = colorVal
        elseif inst:IsA("BasePart") and inst.Parent:FindFirstChildOfClass("Humanoid") == nil then
            -- Không tô màu trực tiếp lên BodyParts của Character để tránh hỏng Outfit
            inst.Color = colorVal
        end
    end)
end

function PerformanceEngine.RegisterInstance(inst, group)
    if ManagedObjects[inst] or not inst then return end
    
    -- Lưu lại trạng thái ban đầu để Khôi Phục Mặc Định
    local origColor = nil
    pcall(function()
        if inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
            origColor = inst.Color
        elseif inst:IsA("Highlight") then
            origColor = inst.FillColor
        elseif inst:IsA("Light") or inst:IsA("BasePart") then
            origColor = inst.Color
        end
    end)

    if origColor then
        ManagedObjects[inst] = {
            OriginalColor = origColor,
            Group = group
        }
        ManagedCount = ManagedCount + 1
        
        -- Cập nhật màu ngay lập tức
        local targetColorName = CONFIG.ApplyToAll and CONFIG.GlobalColor or CONFIG.Groups[group].Color
        local cVal = PerformanceEngine.GetColorValue(targetColorName)
        PerformanceEngine.ApplyColorToObject(inst, cVal)
    end
end

function PerformanceEngine.UnregisterInstance(inst)
    if ManagedObjects[inst] then
        ManagedObjects[inst] = nil
        ManagedCount = math.max(0, ManagedCount - 1)
    end
end

-- Dọn dẹp Garbage Collector tự động khi Instance bị Destroy() trong game
task.spawn(function()
    while task.wait(5) do
        for inst, _ in pairs(ManagedObjects) do
            if not inst or not inst.Parent then
                PerformanceEngine.UnregisterInstance(inst)
            end
        end
    end
end)

-- Quét phân loại đối tượng chuyên sâu
function PerformanceEngine.ClassifyAndRegister(inst, targetGroup)
    if not inst or ManagedObjects[inst] then return end

    if inst:IsA("ParticleEmitter") then
        local name = inst.Name:lower()
        if name:find("dust") or name:find("sand") or name:find("particle") or name:find("bui") then
            PerformanceEngine.RegisterInstance(inst, "CÁT / BỤI / HẠT")
        else
            PerformanceEngine.RegisterInstance(inst, targetGroup)
        end
    elseif inst:IsA("Trail") or inst:IsA("Beam") then
        PerformanceEngine.RegisterInstance(inst, targetGroup)
    elseif inst:IsA("Highlight") then
        PerformanceEngine.RegisterInstance(inst, targetGroup)
    elseif inst:IsA("Light") then
        PerformanceEngine.RegisterInstance(inst, targetGroup)
    end
end

