-- Script Local cho Roblox (đặt trong StarterGui hoặc StarterPlayerScripts)
-- ESP khung hitbox hình vuông, menu kéo thả, thu nhỏ giữ nút bật/tắt, khung bám chính xác theo người chơi khi zoom.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "ESP_Menu_Hack"
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- ==== BIẾN TOÀN CỤC ====
local espEnabled = true
local boxSize = 120
local espObjects = {}

-- ==== TẠO MENU CHÍNH ====
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 250, 0, 180)
mainFrame.Position = UDim2.new(0, 50, 0, 50)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
mainFrame.BackgroundTransparency = 0.15
mainFrame.BorderSizePixel = 1
mainFrame.BorderColor3 = Color3.fromRGB(0, 255, 200)
mainFrame.ClipsDescendants = true
mainFrame.Parent = gui

-- Thanh tiêu đề (kéo thả)
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 25)
titleBar.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
titleBar.BackgroundTransparency = 0.3
titleBar.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 1, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "  ESP HACK v3.1 (orimo)"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.Parent = titleBar

-- Nút thu nhỏ / mở rộng
local toggleMenuBtn = Instance.new("TextButton")
toggleMenuBtn.Size = UDim2.new(0, 20, 0, 20)
toggleMenuBtn.Position = UDim2.new(1, -25, 0, 2)
toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
toggleMenuBtn.Text = "-"
toggleMenuBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleMenuBtn.Font = Enum.Font.GothamBold
toggleMenuBtn.TextSize = 16
toggleMenuBtn.Parent = titleBar

-- Nút bật/tắt ESP (luôn hiển thị)
local toggleEspBtn = Instance.new("TextButton")
toggleEspBtn.Size = UDim2.new(0, 100, 0, 30)
toggleEspBtn.Position = UDim2.new(0.5, -50, 0, 45)
toggleEspBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
toggleEspBtn.Text = "TẮT ESP"
toggleEspBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleEspBtn.Font = Enum.Font.GothamBold
toggleEspBtn.TextSize = 14
toggleEspBtn.Parent = mainFrame

-- Thanh trượt kích thước
local sizeLabel = Instance.new("TextLabel")
sizeLabel.Size = UDim2.new(0, 80, 0, 20)
sizeLabel.Position = UDim2.new(0, 10, 0, 85)
sizeLabel.BackgroundTransparency = 1
sizeLabel.Text = "Kích thước:"
sizeLabel.TextColor3 = Color3.fromRGB(200,200,200)
sizeLabel.TextSize = 12
sizeLabel.Font = Enum.Font.Gotham
sizeLabel.TextXAlignment = Enum.TextXAlignment.Left
sizeLabel.Parent = mainFrame

local sizeSlider = Instance.new("TextBox")
sizeSlider.Size = UDim2.new(0, 60, 0, 20)
sizeSlider.Position = UDim2.new(0, 100, 0, 85)
sizeSlider.BackgroundColor3 = Color3.fromRGB(40,40,50)
sizeSlider.Text = tostring(boxSize)
sizeSlider.TextColor3 = Color3.fromRGB(255,255,255)
sizeSlider.Font = Enum.Font.Gotham
sizeSlider.TextSize = 12
sizeSlider.Parent = mainFrame

local resetPosBtn = Instance.new("TextButton")
resetPosBtn.Size = UDim2.new(0, 80, 0, 25)
resetPosBtn.Position = UDim2.new(0.5, -40, 0, 130)
resetPosBtn.BackgroundColor3 = Color3.fromRGB(80,80,120)
resetPosBtn.Text = "Reset vị trí"
resetPosBtn.TextColor3 = Color3.fromRGB(255,255,255)
resetPosBtn.Font = Enum.Font.Gotham
resetPosBtn.TextSize = 12
resetPosBtn.Parent = mainFrame

-- ==== KÉO THẢ MENU ====
local dragging = false
local dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ==== THU NHỎ / MỞ RỘNG MENU (GIỮ NÚT BẬT TẮT ESP) ====
local menuMinimized = false
toggleMenuBtn.MouseButton1Click:Connect(function()
    menuMinimized = not menuMinimized
    if menuMinimized then
        mainFrame.Size = UDim2.new(0, 250, 0, 60)          -- chỉ đủ cho title + toggleEspBtn
        toggleMenuBtn.Text = "+"
        -- ẩn các thành phần phụ, giữ toggleEspBtn hiển thị
        sizeLabel.Visible = false
        sizeSlider.Visible = false
        resetPosBtn.Visible = false
        -- toggleEspBtn vẫn hiển thị (đã là true mặc định)
    else
        mainFrame.Size = UDim2.new(0, 250, 0, 180)
        toggleMenuBtn.Text = "-"
        sizeLabel.Visible = true
        sizeSlider.Visible = true
        resetPosBtn.Visible = true
    end
end)

-- ==== BẬT TẮT ESP ====
toggleEspBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    toggleEspBtn.Text = espEnabled and "TẮT ESP" or "BẬT ESP"
    toggleEspBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0,180,80) or Color3.fromRGB(180,50,50)
    if not espEnabled then
        for _, obj in pairs(espObjects) do
            if obj and obj.Parent then obj:Destroy() end
        end
        espObjects = {}
    end
end)

-- ==== THAY ĐỔI KÍCH THƯỚC KHUNG ====
sizeSlider.FocusLost:Connect(function(enter)
    if enter then
        local num = tonumber(sizeSlider.Text)
        if num and num > 20 and num < 400 then
            boxSize = num
        else
            sizeSlider.Text = tostring(boxSize)
        end
    end
end)

-- Reset vị trí menu
resetPosBtn.MouseButton1Click:Connect(function()
    mainFrame.Position = UDim2.new(0, 50, 0, 50)
end)

-- ==== TẠO KHUNG ESP ====
local function createEspFrame(player)
    if espObjects[player] then return end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, boxSize, 0, boxSize)
    frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    frame.BackgroundTransparency = 0.6
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    frame.Visible = true
    frame.ZIndex = 10
    frame.Parent = gui
    espObjects[player] = frame
end

-- ==== CẬP NHẬT VỊ TRÍ KHUNG (BÁM THEO HITBOX) ====
local function updateEsp()
    if not espEnabled then return end
    local localChar = LocalPlayer.Character
    if not localChar or not localChar.PrimaryPart then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char.PrimaryPart then
                local rootPos = char.PrimaryPart.Position
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                if head and torso then
                    local headPos = head.Position
                    local footPos = torso.Position - Vector3.new(0, 2.5, 0)

                    local screenRoot, onScreen = Camera:WorldToScreenPoint(rootPos)
                    if onScreen and screenRoot.Z > 0 then
                        local frame = espObjects[player]
                        if not frame then
                            createEspFrame(player)
                            frame = espObjects[player]
                        end
                        if frame then
                            -- Kích thước cố định theo boxSize, nhưng có thể dùng khoảng cách để tự động co giãn nếu muốn (giữ nguyên để đơn giản)
                            frame.Size = UDim2.new(0, boxSize, 0, boxSize)
                            frame.Position = UDim2.new(
                                0, screenRoot.X - boxSize/2,
                                0, screenRoot.Y - boxSize/2
                            )
                            frame.Visible = true
                        end
                    else
                        local frame = espObjects[player]
                        if frame then frame.Visible = false end
                    end
                end
            else
                local frame = espObjects[player]
                if frame then frame.Visible = false end
            end
        end
    end
end

-- ==== XÓA KHI NGƯỜI CHƠI RỜI ====
Players.PlayerRemoving:Connect(function(player)
    local frame = espObjects[player]
    if frame then
        frame:Destroy()
        espObjects[player] = nil
    end
end)

-- ==== VÒNG LẶP RENDER ====
RunService.RenderStepped:Connect(function()
    updateEsp()
end)

-- ==== KHỞI TẠO CHO NGƯỜI CHƠI HIỆN TẠI ====
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createEspFrame(player)
    end
end

-- ==== NGƯỜI CHƠI MỚI ====
Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        createEspFrame(player)
    end
end)

-- ==== DỌN DẸP KHI GUI BỊ XÓA ====
gui.AncestryChanged:Connect(function()
    if not gui.Parent then
        for _, frame in pairs(espObjects) do
            if frame then frame:Destroy() end
        end
        espObjects = {}
    end
end)
