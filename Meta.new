-- =====================================================
-- ESP HACK v4.0 – KHUNG HÌNH VUÔNG HITBOX ĐỘNG, MENU THU NHỎ GIỮ NÚT BẬT/TẮT
-- =====================================================
-- ĐẶT TRONG: StarterGui / StarterPlayerScripts (LocalScript)
-- TÍNH NĂNG:
--   - Khung vuông bao quanh hitbox, kích thước tự động theo chiều cao nhân vật trên màn hình.
--   - Menu kéo thả, thu nhỏ/mở rộng (giữ nguyên nút BẬT/TẮT ESP).
--   - Điều chỉnh hệ số kích thước khung (hệ số nhân, mặc định 1.0).
--   - Bật/tắt ESP tức thì, xóa/tạo lại khung.
--   - Không lỗi khi người chơi rời, nhân vật bị phá hủy, hay zoom camera.
-- =====================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "ESP_Menu_Hack"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- ========== CẤU HÌNH ==========
local ESP_ENABLED = true
local SIZE_MULTIPLIER = 1.0          -- hệ số nhân kích thước (thanh trượt điều chỉnh)
local MIN_MULTIPLIER = 0.3
local MAX_MULTIPLIER = 2.5
local MENU_MINIMIZED = false

-- ========== BIẾN TOÀN CỤC ==========
local espFrames = {}          -- [Player] = Frame
local activePlayers = {}      -- danh sách player đang có frame

-- ========== TẠO MENU CHÍNH ==========
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 260, 0, 180)
mainFrame.Position = UDim2.new(0, 50, 0, 50)
mainFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
mainFrame.BackgroundTransparency = 0.2
mainFrame.BorderSizePixel = 1
mainFrame.BorderColor3 = Color3.fromRGB(0, 255, 200)
mainFrame.ClipsDescendants = true
mainFrame.Parent = gui

-- Thanh tiêu đề (kéo thả)
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 26)
titleBar.BackgroundColor3 = Color3.fromRGB(0, 100, 180)
titleBar.BackgroundTransparency = 0.4
titleBar.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -30, 1, 0)
titleLabel.Position = UDim2.new(0, 5, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "ESP HACK v4.0"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.Parent = titleBar

-- Nút thu nhỏ / mở rộng menu
local toggleMenuBtn = Instance.new("TextButton")
toggleMenuBtn.Size = UDim2.new(0, 22, 0, 22)
toggleMenuBtn.Position = UDim2.new(1, -26, 0, 2)
toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
toggleMenuBtn.Text = "-"
toggleMenuBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleMenuBtn.Font = Enum.Font.GothamBold
toggleMenuBtn.TextSize = 18
toggleMenuBtn.Parent = titleBar

-- Nút bật/tắt ESP (luôn hiển thị)
local toggleEspBtn = Instance.new("TextButton")
toggleEspBtn.Size = UDim2.new(0, 120, 0, 32)
toggleEspBtn.Position = UDim2.new(0.5, -60, 0, 40)
toggleEspBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
toggleEspBtn.Text = "TẮT ESP"
toggleEspBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleEspBtn.Font = Enum.Font.GothamBold
toggleEspBtn.TextSize = 14
toggleEspBtn.Parent = mainFrame

-- Nhãn hệ số kích thước
local sizeLabel = Instance.new("TextLabel")
sizeLabel.Size = UDim2.new(0, 90, 0, 22)
sizeLabel.Position = UDim2.new(0, 10, 0, 85)
sizeLabel.BackgroundTransparency = 1
sizeLabel.Text = "Hệ số:"
sizeLabel.TextColor3 = Color3.fromRGB(200,200,200)
sizeLabel.TextSize = 13
sizeLabel.Font = Enum.Font.Gotham
sizeLabel.TextXAlignment = Enum.TextXAlignment.Left
sizeLabel.Parent = mainFrame

-- Ô nhập hệ số
local sizeInput = Instance.new("TextBox")
sizeInput.Size = UDim2.new(0, 60, 0, 22)
sizeInput.Position = UDim2.new(0, 100, 0, 85)
sizeInput.BackgroundColor3 = Color3.fromRGB(40,40,55)
sizeInput.Text = string.format("%.1f", SIZE_MULTIPLIER)
sizeInput.TextColor3 = Color3.fromRGB(255,255,255)
sizeInput.Font = Enum.Font.Gotham
sizeInput.TextSize = 13
sizeInput.Parent = mainFrame

-- Nút Reset vị trí menu
local resetPosBtn = Instance.new("TextButton")
resetPosBtn.Size = UDim2.new(0, 90, 0, 26)
resetPosBtn.Position = UDim2.new(0.5, -45, 0, 130)
resetPosBtn.BackgroundColor3 = Color3.fromRGB(70,70,110)
resetPosBtn.Text = "Reset vị trí"
resetPosBtn.TextColor3 = Color3.fromRGB(255,255,255)
resetPosBtn.Font = Enum.Font.Gotham
resetPosBtn.TextSize = 12
resetPosBtn.Parent = mainFrame

-- ========== HÀM KÉO THẢ MENU ==========
local dragData = { dragging = false, startPos = nil, dragStart = nil, dragInput = nil }

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragData.dragging = true
        dragData.dragStart = input.Position
        dragData.startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragData.dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragData.dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragData.dragging and input == dragData.dragInput then
        local delta = input.Position - dragData.dragStart
        mainFrame.Position = UDim2.new(
            dragData.startPos.X.Scale, dragData.startPos.X.Offset + delta.X,
            dragData.startPos.Y.Scale, dragData.startPos.Y.Offset + delta.Y
        )
    end
end)

-- ========== XỬ LÝ THU NHỎ / MỞ RỘNG MENU ==========
local function updateMenuSize(minimized)
    MENU_MINIMIZED = minimized
    if minimized then
        mainFrame.Size = UDim2.new(0, 260, 0, 66)          -- đủ chứa thanh title + nút toggle
        toggleMenuBtn.Text = "+"
        -- Ẩn các thành phần phụ
        sizeLabel.Visible = false
        sizeInput.Visible = false
        resetPosBtn.Visible = false
        -- Đưa nút toggle xuống ngay dưới title bar
        toggleEspBtn.Position = UDim2.new(0.5, -60, 0, 30)
    else
        mainFrame.Size = UDim2.new(0, 260, 0, 180)
        toggleMenuBtn.Text = "-"
        sizeLabel.Visible = true
        sizeInput.Visible = true
        resetPosBtn.Visible = true
        toggleEspBtn.Position = UDim2.new(0.5, -60, 0, 40)  -- vị trí cũ
    end
end

toggleMenuBtn.MouseButton1Click:Connect(function()
    updateMenuSize(not MENU_MINIMIZED)
end)

-- ========== XỬ LÝ BẬT/TẮT ESP ==========
local function clearAllFrames()
    for player, frame in pairs(espFrames) do
        if frame and frame.Parent then
            frame:Destroy()
        end
    end
    espFrames = {}
    activePlayers = {}
end

local function rebuildAllFrames()
    clearAllFrames()
    if not ESP_ENABLED then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char.PrimaryPart then
                local frame = Instance.new("Frame")
                frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
                frame.BackgroundTransparency = 0.6
                frame.BorderSizePixel = 2
                frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
                frame.Visible = true
                frame.ZIndex = 10
                frame.Parent = gui
                espFrames[player] = frame
                activePlayers[player] = true
            end
        end
    end
end

toggleEspBtn.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    toggleEspBtn.Text = ESP_ENABLED and "TẮT ESP" or "BẬT ESP"
    toggleEspBtn.BackgroundColor3 = ESP_ENABLED and Color3.fromRGB(0,180,80) or Color3.fromRGB(180,50,50)
    if ESP_ENABLED then
        rebuildAllFrames()
    else
        clearAllFrames()
    end
end)

-- ========== XỬ LÝ HỆ SỐ KÍCH THƯỚC ==========
local function applySizeMultiplier(value)
    local num = tonumber(value)
    if num then
        SIZE_MULTIPLIER = math.clamp(num, MIN_MULTIPLIER, MAX_MULTIPLIER)
        sizeInput.Text = string.format("%.1f", SIZE_MULTIPLIER)
    else
        sizeInput.Text = string.format("%.1f", SIZE_MULTIPLIER)
    end
end

sizeInput.FocusLost:Connect(function(enter)
    if enter then
        applySizeMultiplier(sizeInput.Text)
    end
end)

-- ========== RESET VỊ TRÍ MENU ==========
resetPosBtn.MouseButton1Click:Connect(function()
    mainFrame.Position = UDim2.new(0, 50, 0, 50)
end)

-- ========== CẬP NHẬT VỊ TRÍ VÀ KÍCH THƯỚC KHUNG (MỖI FRAME) ==========
local function updateEspFrames()
    if not ESP_ENABLED then return end
    local localChar = LocalPlayer.Character
    if not localChar then return end

    for player, frame in pairs(espFrames) do
        if player == LocalPlayer then continue end
        local char = player.Character
        if not char then
            if frame.Visible then frame.Visible = false end
            continue
        end
        local head = char:FindFirstChild("Head")
        local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not head or not torso or not root then
            if frame.Visible then frame.Visible = false end
            continue
        end

        -- Lấy vị trí đầu và chân (ước tính chân = torso.Y - 2.5)
        local headPos = head.Position
        local footPos = torso.Position - Vector3.new(0, 2.5, 0)

        local screenHead, onScreenHead = Camera:WorldToScreenPoint(headPos)
        local screenFoot, onScreenFoot = Camera:WorldToScreenPoint(footPos)

        if onScreenHead and onScreenFoot and screenHead.Z > 0 and screenFoot.Z > 0 then
            -- Tính chiều cao trên màn hình (px)
            local heightOnScreen = math.abs(screenHead.Y - screenFoot.Y)
            -- Cạnh khung = chiều cao * hệ số nhân
            local side = heightOnScreen * SIZE_MULTIPLIER
            side = math.clamp(side, 10, 600)  -- giới hạn để tránh quá to/nhỏ

            -- Lấy vị trí trung tâm (từ root)
            local screenRoot, onRoot = Camera:WorldToScreenPoint(root.Position)
            if not onRoot or screenRoot.Z <= 0 then
                if frame.Visible then frame.Visible = false end
                continue
            end

            frame.Size = UDim2.new(0, side, 0, side)
            frame.Position = UDim2.new(
                0, screenRoot.X - side/2,
                0, screenRoot.Y - side/2
            )
            frame.Visible = true
        else
            if frame.Visible then frame.Visible = false end
        end
    end
end

-- ========== QUẢN LÝ NGƯỜI CHƠI THÊM / RỜI ==========
local function addPlayer(player)
    if player == LocalPlayer then return end
    if espFrames[player] then return end
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    frame.BackgroundTransparency = 0.6
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    frame.Visible = true
    frame.ZIndex = 10
    frame.Parent = gui
    espFrames[player] = frame
    activePlayers[player] = true
end

local function removePlayer(player)
    local frame = espFrames[player]
    if frame then
        frame:Destroy()
        espFrames[player] = nil
        activePlayers[player] = nil
    end
end

Players.PlayerAdded:Connect(function(player)
    if ESP_ENABLED then
        player.CharacterAdded:Connect(function(char)
            if ESP_ENABLED and player ~= LocalPlayer then
                addPlayer(player)
            end
        end)
        -- Nếu đã có nhân vật thì thêm ngay
        if player.Character then
            addPlayer(player)
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    removePlayer(player)
end)

-- Xử lý khi nhân vật của người chơi bị xóa (reset)
local function onCharacterRemoving(player)
    if player ~= LocalPlayer then
        -- chỉ ẩn frame chứ không xóa để tránh tạo lại nhiều
        local frame = espFrames[player]
        if frame then
            frame.Visible = false
        end
    end
end

-- Gắn sự kiện cho từng người chơi hiện tại
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        player.CharacterAdded:Connect(function(char)
            if ESP_ENABLED then addPlayer(player) end
        end)
        player.CharacterRemoving:Connect(function()
            onCharacterRemoving(player)
        end)
        if player.Character then
            addPlayer(player)
        end
    end
end

-- ========== VÒNG LẶP RENDER ==========
RunService.RenderStepped:Connect(function()
    updateEspFrames()
end)

-- ========== KHỞI TẠO BAN ĐẦU ==========
-- Tạo frame cho tất cả người chơi hiện có (nếu ESP bật)
if ESP_ENABLED then
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            addPlayer(player)
        end
    end
end

-- ========== DỌN DẸP KHI GUI BỊ XÓA ==========
gui.AncestryChanged:Connect(function()
    if not gui.Parent then
        clearAllFrames()
    end
end)

-- ========== THÔNG BÁO HOÀN TẤT ==========
print("ESP HACK v4.0 đã sẵn sàng. Menu có thể kéo thả, thu nhỏ giữ nút bật/tắt.")
