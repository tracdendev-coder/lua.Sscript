-- Axiom | Delta Client-Side Lag Fix
-- CHẠY TRỰC TIẾP TRÊN DELTA / EXECUTOR - KHÔNG CẦN STUDIO
-- Đúng chuẩn Lua Roblox, không phụ thuộc bên thứ ba

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local LocalPlayer = Players.LocalPlayer
local lastFullClean = 0

-- Cấu hình khóa chặt yêu cầu
local CONFIG = {
    KeepOnlyBaseColor = true,       -- Chỉ giữ màu gốc, không hiệu ứng màu đổi/chói
    StripAllVisualTrash = true,     -- Xóa lửa, tia sáng, nổ, hạt, ánh sáng
    GutHeavyParts = true,           -- Bỏ ruột khối nặng, chỉ giữ hình khối + màu
    KillUnusedLogic = true,         -- Dọn script thừa làm giật
    AutoCleanInterval = 4           -- Tự dọn định kỳ không gây tải
}

-- Tối ưu ánh sáng toàn cục ngay lập tức
do
    Lighting.Ambient = Color3.new(0.65, 0.65, 0.65)
    Lighting.OutdoorAmbient = Color3.new(0.75, 0.75, 0.75)
    Lighting.Brightness = 1
    Lighting.ShadowSoftness = 0
    Lighting.EnvironmentSpecularScale = 0
    Lighting.ColorShift_Top = Color3.new(1,1,1)
    Lighting.ColorShift_Bottom = Color3.new(1,1,1)

    -- Xóa sạch hiệu ứng ánh sáng nặng
    for _, fx in pairs(Lighting:GetChildren()) do
        if fx:IsA("BloomEffect") or fx:IsA("SunRaysEffect") or fx:IsA("DepthOfFieldEffect") 
        or fx:IsA("ColorCorrectionEffect") or fx:IsA("BlurEffect") or fx:IsA("GrainEffect") then
            fx:Destroy()
        end
    end
end

-- Hàm xử lý chính - chạy nhanh, không chặn luồng
local function OptimizeItem(item)
    if not item or not item:IsDescendantOf(game) then return end
    if item:IsDescendantOf(LocalPlayer.Character or LocalPlayer) then return end

    -- Xóa sạch mọi hiệu ứng hình ảnh nặng
    if CONFIG.StripAllVisualTrash then
        if item:IsA("ParticleEmitter") or item:IsA("Fire") or item:IsA("Smoke") 
        or item:IsA("Sparkles") or item:IsA("PointLight") or item:IsA("SpotLight")
        or item:IsA("Trail") or item:IsA("Explosion") or item:IsA("ForceField") then
            item:Destroy()
            return
        end
    end

    -- Xử lý khối vật lý - bỏ ruột, giữ màu nhận biết
    if item:IsA("BasePart") then
        local savedColor = item.Color -- Lưu lại màu gốc trước khi chỉnh

        if CONFIG.GutHeavyParts then
            item.Material = Enum.Material.SmoothPlastic
            item.CastShadow = false
            item.Reflectance = 0
            item.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0)
            
            -- Xóa hết đồ trang trí ruột khối
            for _, child in pairs(item:GetChildren()) do
                if child:IsA("SpecialMesh") or child:IsA("Decal") or child:IsA("Texture") 
                or child:IsA("Motor6D") or child:IsA("Weld") and not item:IsDescendantOf(LocalPlayer.Character) then
                    child:Destroy()
                end
            end
        end

        -- Khóa màu gốc, xóa mọi logic đổi màu
        if CONFIG.KeepOnlyBaseColor then
            item.Color = savedColor
            item.BrickColor = BrickColor.new(savedColor)
            for _, scr in pairs(item:GetChildren()) do
                if scr:IsA("Script") or scr:IsA("LocalScript") or scr:IsA("ValueBase") then
                    local n = scr.Name:lower()
                    if n:find("color") or n:find("fade") or n:find("glow") or n:find("flash") then
                        scr:Destroy()
                    end
                end
            end
        end
    end

    -- Xóa script/đối tượng thừa gây tải
    if CONFIG.KillUnusedLogic then
        if item:IsA("Script") or item:IsA("LocalScript") then
            local n = item.Name:lower()
            if n:find("effect") or n:find("visual") or n:find("animate") or n:find("particle") then
                Debris:AddItem(item, 0)
            end
        end
    end
end

-- Quét toàn bộ hệ thống
local function FullSystemClean()
    for _, desc in pairs(Workspace:GetDescendants()) do
        task.spawn(OptimizeItem, desc)
    end
    for _, desc in pairs(ReplicatedStorage:GetDescendants()) do
        if desc:IsA("ParticleEmitter") or desc:IsA("Fire") then desc:Destroy() end
    end
end

-- Chạy ngay khi khởi động
FullSystemClean()

-- Bắt đối tượng mới xuất hiện để tối ưu ngay
Workspace.DescendantAdded:Connect(function(item)
    task.delay(0, OptimizeItem, item)
end)

-- Tự dọn định kỳ không gây giật
RunService.Heartbeat:Connect(function()
    local now = os.clock()
    if now - lastFullClean >= CONFIG.AutoCleanInterval then
        lastFullClean = now
        task.spawn(FullSystemClean)
    end
end)

print("✅ HOÀN TẤT - Đã tối ưu xong ông chủ! Chạy ngon trên Delta, không cần Studio gì cả. FPS bay luôn!")
