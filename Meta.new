-- =====================================================
-- ORBIT BLOCK v1.1 – MENU CÓ THANH TRƯỢT BÁN KÍNH (LocalScript)
-- =====================================================
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local remote = Instance.new("RemoteEvent")
remote.Name = "OrbitControl"
remote.Parent = ReplicatedStorage

-- Tạo GUI
local gui = Instance.new("ScreenGui")
gui.Name = "OrbitMenu"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 320, 0, 260)  -- tăng chiều cao để chứa slider
mainFrame.Position = UDim2.new(0, 50, 0, 50)
mainFrame.BackgroundColor3 = Color3.fromRGB(10, 10, 25)
mainFrame.BackgroundTransparency = 0.2
mainFrame.BorderSizePixel = 1
mainFrame.BorderColor3 = Color3.fromRGB(255, 200, 0)
mainFrame.ClipsDescendants = true
mainFrame.Parent = gui

-- Thanh tiêu đề
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 26)
titleBar.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
titleBar.BackgroundTransparency = 0.3
titleBar.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, -30, 1, 0)
titleLabel.Position = UDim2.new(0, 5, 0, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "ORBIT BLOCK v1.1"
titleLabel.TextColor3 = Color3.fromRGB(255,255,255)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.Parent = titleBar

local toggleMenuBtn = Instance.new("TextButton")
toggleMenuBtn.Size = UDim2.new(0, 22, 0, 22)
toggleMenuBtn.Position = UDim2.new(1, -26, 0, 2)
toggleMenuBtn.BackgroundColor3 = Color3.fromRGB(200, 40, 40)
toggleMenuBtn.Text = "-"
toggleMenuBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleMenuBtn.Font = Enum.Font.GothamBold
toggleMenuBtn.TextSize = 18
toggleMenuBtn.Parent = titleBar

-- Nút bật/tắt
local toggleOrbitBtn = Instance.new("TextButton")
toggleOrbitBtn.Size = UDim2.new(0, 130, 0, 32)
toggleOrbitBtn.Position = UDim2.new(0.5, -65, 0, 40)
toggleOrbitBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
toggleOrbitBtn.Text = "BẬT ORBIT"
toggleOrbitBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleOrbitBtn.Font = Enum.Font.GothamBold
toggleOrbitBtn.TextSize = 14
toggleOrbitBtn.Parent = mainFrame

-- === THANH TRƯỢT BÁN KÍNH ===
local radiusLabel = Instance.new("TextLabel")
radiusLabel.Size = UDim2.new(0, 80, 0, 22)
radiusLabel.Position = UDim2.new(0, 10, 0, 85)
radiusLabel.BackgroundTransparency = 1
radiusLabel.Text = "Bán kính:"
radiusLabel.TextColor3 = Color3.fromRGB(200,200,200)
radiusLabel.TextSize = 13
radiusLabel.Font = Enum.Font.Gotham
radiusLabel.TextXAlignment = Enum.TextXAlignment.Left
radiusLabel.Parent = mainFrame

-- Giá trị hiển thị bên cạnh
local radiusValueLabel = Instance.new("TextLabel")
radiusValueLabel.Size = UDim2.new(0, 40, 0, 22)
radiusValueLabel.Position = UDim2.new(0, 85, 0, 85)
radiusValueLabel.BackgroundTransparency = 1
radiusValueLabel.Text = "8"
radiusValueLabel.TextColor3 = Color3.fromRGB(255,255,255)
radiusValueLabel.TextSize = 13
radiusValueLabel.Font = Enum.Font.GothamBold
radiusValueLabel.TextXAlignment = Enum.TextXAlignment.Center
radiusValueLabel.Parent = mainFrame

-- Thanh trượt (slider)
local sliderTrack = Instance.new("Frame")
sliderTrack.Size = UDim2.new(0, 150, 0, 6)
sliderTrack.Position = UDim2.new(0, 130, 0, 93) -- canh ngang với label
sliderTrack.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
sliderTrack.BorderSizePixel = 0
sliderTrack.Parent = mainFrame

local sliderFill = Instance.new("Frame")
sliderFill.Size = UDim2.new(0.5, 0, 1, 0) -- mặc định 50%
sliderFill.BackgroundColor3 = Color3.fromRGB(0, 200, 255)
sliderFill.BorderSizePixel = 0
sliderFill.Parent = sliderTrack

local sliderHandle = Instance.new("TextButton")
sliderHandle.Size = UDim2.new(0, 16, 0, 16)
sliderHandle.Position = UDim2.new(0.5, -8, 0, -5) -- canh giữa fill
sliderHandle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
sliderHandle.Text = ""
sliderHandle.BorderSizePixel = 1
sliderHandle.BorderColor3 = Color3.fromRGB(0, 150, 200)
sliderHandle.Parent = sliderTrack

-- Tốc độ (giữ ô nhập)
local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0, 70, 0, 22)
speedLabel.Position = UDim2.new(0, 10, 0, 125)
speedLabel.BackgroundTransparency = 1
speedLabel.Text = "Tốc độ:"
speedLabel.TextColor3 = Color3.fromRGB(200,200,200)
speedLabel.TextSize = 13
speedLabel.Font = Enum.Font.Gotham
speedLabel.TextXAlignment = Enum.TextXAlignment.Left
speedLabel.Parent = mainFrame

local speedInput = Instance.new("TextBox")
speedInput.Size = UDim2.new(0, 60, 0, 22)
speedInput.Position = UDim2.new(0, 85, 0, 125)
speedInput.BackgroundColor3 = Color3.fromRGB(40,40,55)
speedInput.Text = "2"
speedInput.TextColor3 = Color3.fromRGB(255,255,255)
speedInput.Font = Enum.Font.Gotham
speedInput.TextSize = 13
speedInput.Parent = mainFrame

-- Số lượng (giữ ô nhập)
local countLabel = Instance.new("TextLabel")
countLabel.Size = UDim2.new(0, 70, 0, 22)
countLabel.Position = UDim2.new(0, 10, 0, 155)
countLabel.BackgroundTransparency = 1
countLabel.Text = "Số lượng:"
countLabel.TextColor3 = Color3.fromRGB(200,200,200)
countLabel.TextSize = 13
countLabel.Font = Enum.Font.Gotham
countLabel.TextXAlignment = Enum.TextXAlignment.Left
countLabel.Parent = mainFrame

local countInput = Instance.new("TextBox")
countInput.Size = UDim2.new(0, 60, 0, 22)
countInput.Position = UDim2.new(0, 85, 0, 155)
countInput.BackgroundColor3 = Color3.fromRGB(40,40,55)
countInput.Text = "12"
countInput.TextColor3 = Color3.fromRGB(255,255,255)
countInput.Font = Enum.Font.Gotham
countInput.TextSize = 13
countInput.Parent = mainFrame

local resetPosBtn = Instance.new("TextButton")
resetPosBtn.Size = UDim2.new(0, 90, 0, 26)
resetPosBtn.Position = UDim2.new(0.5, -45, 0, 195)
resetPosBtn.BackgroundColor3 = Color3.fromRGB(70,70,110)
resetPosBtn.Text = "Reset vị trí"
resetPosBtn.TextColor3 = Color3.fromRGB(255,255,255)
resetPosBtn.Font = Enum.Font.Gotham
resetPosBtn.TextSize = 12
resetPosBtn.Parent = mainFrame

-- === LOGIC KÉO THẢ MENU ===
local dragData = { dragging = false, startPos = nil, startMouse = nil }
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragData.dragging = true
        dragData.startMouse = input.Position
        dragData.startPos = mainFrame.Position
    end
end)
titleBar.InputChanged:Connect(function(input)
    if dragData.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragData.startMouse
        mainFrame.Position = UDim2.new(
            dragData.startPos.X.Scale, dragData.startPos.X.Offset + delta.X,
            dragData.startPos.Y.Scale, dragData.startPos.Y.Offset + delta.Y
        )
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragData.dragging = false
    end
end)

-- === THU NHỎ ===
local minimized = false
toggleMenuBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    mainFrame.Size = minimized and UDim2.new(0, 320, 0, 66) or UDim2.new(0, 320, 0, 260)
    toggleMenuBtn.Text = minimized and "+" or "-"
    -- ẩn tất cả thành phần phụ
    radiusLabel.Visible = not minimized
    radiusValueLabel.Visible = not minimized
    sliderTrack.Visible = not minimized
    speedLabel.Visible = not minimized
    speedInput.Visible = not minimized
    countLabel.Visible = not minimized
    countInput.Visible = not minimized
    resetPosBtn.Visible = not minimized
    toggleOrbitBtn.Position = minimized and UDim2.new(0.5, -65, 0, 30) or UDim2.new(0.5, -65, 0, 40)
end)

-- === LOGIC THANH TRƯỢT ===
local minRadius = 2
local maxRadius = 30
local currentRadius = 8

local function updateSlider(value)
    local clamped = math.clamp(value, minRadius, maxRadius)
    currentRadius = clamped
    radiusValueLabel.Text = tostring(math.round(clamped * 10) / 10) -- làm tròn 1 chữ số
    -- Cập nhật fill và handle
    local percent = (clamped - minRadius) / (maxRadius - minRadius)
    sliderFill.Size = UDim2.new(percent, 0, 1, 0)
    sliderHandle.Position = UDim2.new(percent, -8, 0, -5)
    -- Gửi lên server nếu đang bật
    if toggleOrbitBtn.Text == "TẮT ORBIT" then
        sendOrbitState()
    end
end

local function getSliderValueFromMouse(mouseX)
    local trackPos = sliderTrack.AbsolutePosition.X
    local trackSize = sliderTrack.AbsoluteSize.X
    local relative = (mouseX - trackPos) / trackSize
    return minRadius + relative * (maxRadius - minRadius)
end

local isDraggingSlider = false

sliderHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDraggingSlider = true
        local mousePos = input.Position
        local val = getSliderValueFromMouse(mousePos.X)
        updateSlider(val)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isDraggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        local val = getSliderValueFromMouse(input.Position.X)
        updateSlider(val)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        isDraggingSlider = false
    end
end)

-- Cũng cho phép click trên track để nhảy
sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local val = getSliderValueFromMouse(input.Position.X)
        updateSlider(val)
    end
end)

-- === GỬI LỆNH ===
local function sendOrbitState()
    local data = {
        enabled = (toggleOrbitBtn.Text == "TẮT ORBIT"),
        radius = currentRadius,
        speed = tonumber(speedInput.Text) or 2,
        count = math.floor(tonumber(countInput.Text) or 12)
    }
    remote:FireServer(data)
end

local function toggleOrbit()
    local isOn = toggleOrbitBtn.Text == "BẬT ORBIT"
    toggleOrbitBtn.Text = isOn and "TẮT ORBIT" or "BẬT ORBIT"
    toggleOrbitBtn.BackgroundColor3 = isOn and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(0, 180, 80)
    sendOrbitState()
end

toggleOrbitBtn.MouseButton1Click:Connect(toggleOrbit)

-- Gửi khi thay đổi thông số khác
local function onParamChange()
    if toggleOrbitBtn.Text == "TẮT ORBIT" then
        sendOrbitState()
    end
end
speedInput.FocusLost:Connect(onParamChange)
countInput.FocusLost:Connect(onParamChange)

resetPosBtn.MouseButton1Click:Connect(function()
    mainFrame.Position = UDim2.new(0, 50, 0, 50)
end)

-- Khởi tạo slider về mặc định
updateSlider(8)

-- Khởi tạo trạng thái tắt
task.wait(1)
remote:FireServer({ enabled = false })
