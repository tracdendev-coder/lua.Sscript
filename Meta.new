-- Script Local cho Roblox (đặt trong StarterGui hoặc StarterPlayerScripts)
-- Chức năng: ESP khung hitbox hình vuông, menu kéo thả, phóng to thu nhỏ, bật tắt.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

local LocalPlayer = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "ESP_Menu_Hack"
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- ==== BIẾN TOÀN CỤC ====
local espEnabled = true
local boxSize = 120  -- kích thước cạnh hình vuông (px)
local espObjects = {} -- bảng lưu Frame cho từng người chơi

-- ==== TẠO MENU CHÍNH ====
local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 250, 0, 180)
mainFrame.Position = UDim2.new(0, 50, 0, 50)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
mainFrame.BackgroundTransparency = 0.15
mainFrame.BorderSizePixel = 1
mainFrame.BorderColor3 = Color3.fromRGB(0, 255, 200)
mainFrame.ClipsDescendants = true
mainFrame.Parent = gui

-- Tiêu đề (thanh kéo)
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 25)
titleBar.BackgroundColor3 = Color3.fromRGB(0, 120, 200)
titleBar.BackgroundTransparency = 0.3
titleBar.Parent = mainFrame

local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 1, 0)
titleLabel.BackgroundTransparency = 1
titleLabel.Text = "  ESP HACK v3.0 (orimo)"
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextXAlignment = Enum.TextXAlignment.Left
titleLabel.Font = Enum.Font.GothamBold
titleLabel.TextSize = 14
titleLabel.Parent = titleBar

-- Nút đóng (thu nhỏ menu)
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 20, 0, 20)
closeBtn.Position = UDim2.new(1, -25, 0, 2)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
closeBtn.Text = "-"
closeBtn.TextColor3 = Color3.fromRGB(255,255,255)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextSize = 16
closeBtn.Parent = titleBar

-- Nút bật/tắt ESP
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(0, 100, 0, 30)
toggleBtn.Position = UDim2.new(0.5, -50, 0, 45)
toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
toggleBtn.Text = "TẮT ESP"
toggleBtn.TextColor3 = Color3.fromRGB(255,255,255)
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.TextSize = 14
toggleBtn.Parent = mainFrame

-- Thanh trượt kích thước khung
local sizeLabel = Instance.new("TextLabel")
sizeLabel.Size = UDim2.new(0, 80, 0, 20)
sizeLabel.Position = UDim2.new(0, 10, 0, 85)
sizeLabel.BackgroundTransparency = 1
sizeLabel.Text = "Kích thước:"
sizeLabel.TextColor3 = Color3.fromRGB(200,200,200)
sizeLabel.TextSize = 12
sizeLabel.Font = Enum.Font.Gotham
sizeLabel.TextXAlignment = Enum.TextXAlignment.Left
sizeLabel.Parent = mainFrame

local sizeSlider = Instance.new("TextBox")
sizeSlider.Size = UDim2.new(0, 60, 0, 20)
sizeSlider.Position = UDim2.new(0, 100, 0, 85)
sizeSlider.BackgroundColor3 = Color3.fromRGB(40,40,50)
sizeSlider.Text = tostring(boxSize)
sizeSlider.TextColor3 = Color3.fromRGB(255,255,255)
sizeSlider.Font = Enum.Font.Gotham
sizeSlider.TextSize = 12
sizeSlider.Parent = mainFrame

-- Nút Reset vị trí menu
local resetPosBtn = Instance.new("TextButton")
resetPosBtn.Size = UDim2.new(0, 80, 0, 25)
resetPosBtn.Position = UDim2.new(0.5, -40, 0, 130)
resetPosBtn.BackgroundColor3 = Color3.fromRGB(80,80,120)
resetPosBtn.Text = "Reset vị trí"
resetPosBtn.TextColor3 = Color3.fromRGB(255,255,255)
resetPosBtn.Font = Enum.Font.Gotham
resetPosBtn.TextSize = 12
resetPosBtn.Parent = mainFrame

-- ==== LOGIC KÉO THẢ MENU ====
local dragging = false
local dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

-- ==== NÚT ĐÓNG/THU NHỎ ====
local menuMinimized = false
closeBtn.MouseButton1Click:Connect(function()
    menuMinimized = not menuMinimized
    if menuMinimized then
        mainFrame.Size = UDim2.new(0, 250, 0, 30)
        closeBtn.Text = "+"
        -- ẩn các thành phần khác
        toggleBtn.Visible = false
        sizeLabel.Visible = false
        sizeSlider.Visible = false
        resetPosBtn.Visible = false
    else
        mainFrame.Size = UDim2.new(0, 250, 0, 180)
        closeBtn.Text = "-"
        toggleBtn.Visible = true
        sizeLabel.Visible = true
        sizeSlider.Visible = true
        resetPosBtn.Visible = true
    end
end)

-- ==== LOGIC BẬT TẮT ESP ====
toggleBtn.MouseButton1Click:Connect(function()
    espEnabled = not espEnabled
    toggleBtn.Text = espEnabled and "TẮT ESP" or "BẬT ESP"
    toggleBtn.BackgroundColor3 = espEnabled and Color3.fromRGB(0,180,80) or Color3.fromRGB(180,50,50)
    if not espEnabled then
        -- Xóa toàn bộ khung ESP
        for _, obj in pairs(espObjects) do
            if obj and obj.Parent then obj:Destroy() end
        end
        espObjects = {}
    end
end)

-- ==== THAY ĐỔI KÍCH THƯỚC ====
sizeSlider.FocusLost:Connect(function(enter)
    if enter then
        local num = tonumber(sizeSlider.Text)
        if num and num > 20 and num < 400 then
            boxSize = num
        else
            sizeSlider.Text = tostring(boxSize)
        end
    end
end)

-- Reset vị trí
resetPosBtn.MouseButton1Click:Connect(function()
    mainFrame.Position = UDim2.new(0, 50, 0, 50)
end)

-- ==== TẠO KHUNG ESP CHO MỘT NGƯỜI CHƠI ====
local function createEspFrame(player)
    if espObjects[player] then return end
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, boxSize, 0, boxSize)
    frame.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    frame.BackgroundTransparency = 0.6
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.fromRGB(0, 255, 0)
    frame.Visible = true
    frame.ZIndex = 10
    frame.Parent = gui
    espObjects[player] = frame
end

-- ==== CẬP NHẬT VỊ TRÍ KHUNG ====
local function updateEsp()
    if not espEnabled then return end
    local localChar = LocalPlayer.Character
    if not localChar or not localChar.PrimaryPart then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char.PrimaryPart then
                local rootPos = char.PrimaryPart.Position
                local head = char:FindFirstChild("Head")
                local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                if head and torso then
                    local headPos = head.Position
                    local footPos = torso.Position - Vector3.new(0, 2.5, 0) -- ước tính chân

                    local screenRoot, onScreen = Camera:WorldToScreenPoint(rootPos)
                    local screenHead, _ = Camera:WorldToScreenPoint(headPos)
                    local screenFoot, _ = Camera:WorldToScreenPoint(footPos)

                    if onScreen and screenRoot.Z > 0 then
                        local dist = (screenHead.Y - screenFoot.Y)
                        local size = math.clamp(dist * 0.8, 30, 250)
                        -- sử dụng kích thước từ thanh trượt, nhưng có thể điều chỉnh theo khoảng cách
                        local finalSize = boxSize -- hoặc có thể dùng size động, để đơn giản dùng boxSize

                        local frame = espObjects[player]
                        if not frame then
                            createEspFrame(player)
                            frame = espObjects[player]
                        end
                        if frame then
                            frame.Size = UDim2.new(0, finalSize, 0, finalSize)
                            frame.Position = UDim2.new(
                                0, screenRoot.X - finalSize/2,
                                0, screenRoot.Y - finalSize/2
                            )
                            frame.Visible = true
                        end
                    else
                        -- ẩn nếu không trên màn hình
                        local frame = espObjects[player]
                        if frame then frame.Visible = false end
                    end
                end
            else
                local frame = espObjects[player]
                if frame then frame.Visible = false end
            end
        end
    end
end

-- ==== XÓA ESP CHO NGƯỜI RỜI ====
Players.PlayerRemoving:Connect(function(player)
    local frame = espObjects[player]
    if frame then
        frame:Destroy()
        espObjects[player] = nil
    end
end)

-- ==== VÒNG LẶP CHÍNH ====
RunService.RenderStepped:Connect(function()
    updateEsp()
end)

-- ==== KHỞI TẠO ESP CHO CÁC NGƯỜI CHƠI HIỆN TẠI ====
for _, player in pairs(Players:GetPlayers()) do
    if player ~= LocalPlayer then
        createEspFrame(player)
    end
end

-- ==== THÊM NGƯỜI CHƠI MỚI ====
Players.PlayerAdded:Connect(function(player)
    if player ~= LocalPlayer then
        createEspFrame(player)
    end
end)

-- ==== XÓA SẠCH KHI DISABLE ====
gui.AncestryChanged:Connect(function()
    if not gui.Parent then
        for _, frame in pairs(espObjects) do
            if frame then frame:Destroy() end
        end
        espObjects = {}
    end
end)
